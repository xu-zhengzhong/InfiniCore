#include "../../../devices/bang/common_bang.h"
#include "syrk_bang.h"
#include "syrk_bang_kernel.mlu"

namespace {

template <typename Tdata>
void dispatchSyrkKernel(
    int task_count,
    cnrtDim3_t k_dim,
    cnrtFunctionType_t k_type,
    cnrtQueue_t queue,
    infiniopBlasFillMode_t uplo,
    infiniopBlasOperation_t trans,
    int n,
    int k,
    const Tdata *alpha,
    const Tdata *A,
    int lda,
    const Tdata *beta,
    Tdata *C,
    int ldc) {

    const int tile_count_8 = CEIL_DIV(n, 8) * CEIL_DIV(n, 8);
    const int tile_count_16 = CEIL_DIV(n, 16) * CEIL_DIV(n, 16);

    if (tile_count_16 >= task_count || tile_count_8 < task_count) {
        syrkKernel<Tdata, 16><<<k_dim, k_type, queue>>>(uplo, trans, n, k, alpha, A, lda, beta, C, ldc);
    } else {
        syrkKernel<Tdata, 8><<<k_dim, k_type, queue>>>(uplo, trans, n, k, alpha, A, lda, beta, C, ldc);
    }
}

} // namespace

namespace op::syrk::bang {

struct Descriptor::Opaque {
    std::shared_ptr<device::bang::Handle::Internal> internal;
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopBlasFillMode_t uplo,
    infiniopBlasOperation_t trans,
    infiniopTensorDescriptor_t alpha_desc,
    infiniopTensorDescriptor_t A_desc,
    infiniopTensorDescriptor_t beta_desc,
    infiniopTensorDescriptor_t C_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = SyrkInfo::createSyrkInfo(uplo, trans, alpha_desc, A_desc, beta_desc, C_desc);
    CHECK_RESULT(result);

    *desc_ptr = new Descriptor(
        result.take(),
        0,
        new Descriptor::Opaque{handle->internal()},
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

template <typename Tdata>
infiniStatus_t calculateSyrk(
    const SyrkInfo &info,
    const Tdata *alpha,
    const Tdata *A,
    const Tdata *beta,
    Tdata *C,
    int core_per_cluster,
    int cluster_count,
    cnrtQueue_t queue) {

    const int n = utils::cast<int>(info.n);
    const int k = utils::cast<int>(info.k);
    auto uplo = info.uplo;
    auto trans = info.trans;

    int lda = 0;
    if (info.A_row_stride == 1) {
        lda = utils::cast<int>(info.A_col_stride);
    } else {
        lda = utils::cast<int>(info.A_row_stride);
        trans = info.trans == INFINIOP_BLAS_OP_N ? INFINIOP_BLAS_OP_T : INFINIOP_BLAS_OP_N;
    }

    int ldc = 0;
    if (info.C_row_stride == 1) {
        ldc = utils::cast<int>(info.C_col_stride);
    } else {
        ldc = utils::cast<int>(info.C_row_stride);
        uplo = info.uplo == INFINIOP_BLAS_FILL_MODE_UPPER
                 ? INFINIOP_BLAS_FILL_MODE_LOWER
                 : INFINIOP_BLAS_FILL_MODE_UPPER;
    }

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = core_per_cluster;
    k_dim.y = cluster_count;
    k_dim.z = 1;
    k_type = cnrtFuncTypeUnion1;

    dispatchSyrkKernel<Tdata>(
        core_per_cluster * cluster_count,
        k_dim,
        k_type,
        queue,
        uplo,
        trans,
        n,
        k,
        alpha,
        A,
        lda,
        beta,
        C,
        ldc);

    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

#define CALCULATE_SYRK(TDATA)           \
    calculateSyrk(_info,                \
                  (const TDATA *)alpha, \
                  (const TDATA *)A,     \
                  (const TDATA *)beta,  \
                  (TDATA *)C,           \
                  core_per_cluster,     \
                  cluster_count,        \
                  (cnrtQueue_t)stream)

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *alpha,
    const void *A,
    const void *beta,
    void *C,
    void *stream) const {

    (void)workspace;
    (void)workspace_size;

    int core_per_cluster = _opaque->internal->getCorePerCluster();
    int cluster_count = _opaque->internal->getClusterCount();

    switch (_info.data_type) {
    case INFINI_DTYPE_F32:
        return CALCULATE_SYRK(float);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

#undef CALCULATE_SYRK

} // namespace op::syrk::bang
