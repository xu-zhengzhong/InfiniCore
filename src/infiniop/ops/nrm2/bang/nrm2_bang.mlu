#include "../../../devices/bang/common_bang.h"
#include "nrm2_bang.h"
#include "nrm2_bang_kernel.mlu"

namespace op::nrm2::bang {

Descriptor::~Descriptor() = default;

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopTensorDescriptor_t x_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto info = Nrm2Info::createNrm2Info(x_desc);
    CHECK_RESULT(info);

    size_t workspace_size = infiniSizeOf(x_desc->dtype());

    // Create descriptor
    *desc_ptr = new Descriptor(
        info.take(),
        workspace_size,
        nullptr,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

template <typename Tdata>
infiniStatus_t calculateNrm2(
    const Nrm2Info &info,
    const void *x,
    void *result,
    cnrtQueue_t queue,
    void *workspace,
    size_t workspace_size) {

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = 4;
    k_dim.y = 1;
    k_dim.z = 1;
    k_type = cnrtFuncTypeUnion1;

    Tdata *d_result = (Tdata *)workspace;

    if (info.getIncx() == 1) {
        Nrm2KernelContiguous<Tdata><<<k_dim, k_type, queue>>>(
            info.getSize(),
            (const Tdata *)x,
            d_result);
    } else {
        Nrm2KernelStrided<Tdata><<<k_dim, k_type, queue>>>(
            info.getSize(),
            (const Tdata *)x,
            info.getIncx(),
            d_result);
    }

    cnrtMemcpyAsync(result, d_result, workspace_size, queue, cnrtMemcpyDevToHost);

    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *x,
    void *result,
    void *stream) const {

#define CALCULATE_NRM2(TDATA) \
    calculateNrm2<TDATA>(     \
        _info,                \
        x, result,            \
        (cnrtQueue_t)stream, workspace, workspace_size)

    switch (_info.getDtype()) {
    case INFINI_DTYPE_F32:
        return CALCULATE_NRM2(float);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

#undef CALCULATE_NRM2

} // namespace op::nrm2::bang