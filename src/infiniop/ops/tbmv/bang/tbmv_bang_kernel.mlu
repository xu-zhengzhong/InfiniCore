#include "../../../devices/bang/common_bang.h"
#include "tbmv_bang.h"

__nram__ char nram_buffer[NRAM_MAX_SIZE];

template <typename Tdata, bool X_CONTIGUOUS>
__mlu_func__ void tbmvCopyKernelImpl(
    int n,
    const Tdata *x, int incx,
    Tdata *x_copy) {

    char *nram_aligned = (char *)(((size_t)nram_buffer + ALIGN_SIZE - 1) & ~(ALIGN_SIZE - 1));

    size_t nram_usable = NRAM_MAX_SIZE - (nram_aligned - nram_buffer);
    size_t max_chunk_elements = nram_usable / sizeof(Tdata);

    size_t align_elements = ALIGN_SIZE / sizeof(Tdata);
    if (align_elements == 0) {
        align_elements = 1;
    }
    int chunk_size = (int)((max_chunk_elements / align_elements) * align_elements);

    Tdata *nram_x = (Tdata *)nram_aligned;

    int elements_per_core = n / taskDim;
    int remain = n % taskDim;
    int core_elements = elements_per_core + (taskId < remain ? 1 : 0);
    int core_offset = taskId < remain ? taskId * core_elements : taskId * elements_per_core + remain;

    if (core_elements <= 0) {
        return;
    }

    int chunks = core_elements / chunk_size;
    int chunk_rem = core_elements % chunk_size;

    for (int c = 0; c < chunks; c++) {
        int current_offset = core_offset + c * chunk_size;

        if constexpr (X_CONTIGUOUS) {
            __memcpy(nram_x, x + current_offset, chunk_size * sizeof(Tdata), GDRAM2NRAM);
        } else {
            for (int i = 0; i < chunk_size; ++i) {
                nram_x[i] = x[(current_offset + i) * incx];
            }
        }
        __memcpy(x_copy + current_offset, nram_x, chunk_size * sizeof(Tdata), NRAM2GDRAM);
    }

    if (chunk_rem > 0) {
        int current_offset = core_offset + chunks * chunk_size;

        if constexpr (X_CONTIGUOUS) {
            __memcpy(nram_x, x + current_offset, chunk_rem * sizeof(Tdata), GDRAM2NRAM);
        } else {
            for (int i = 0; i < chunk_rem; ++i) {
                nram_x[i] = x[(current_offset + i) * incx];
            }
        }
        __memcpy(x_copy + current_offset, nram_x, chunk_rem * sizeof(Tdata), NRAM2GDRAM);
    }
}

#define DISPATCH_TBMV_COPY(CONTIG) \
    tbmvCopyKernelImpl<Tdata, CONTIG>(n, x, incx, x_copy)

template <typename Tdata>
__mlu_global__ void tbmvCopyKernel(
    int n,
    const Tdata *x, int incx,
    Tdata *x_copy) {

    const bool x_contiguous = incx == 1;

    if (x_contiguous) {
        DISPATCH_TBMV_COPY(true);
    } else {
        DISPATCH_TBMV_COPY(false);
    }

#undef DISPATCH_TBMV_COPY
}

template <typename Tdata>
__mlu_func__ void loadTbmvXChunk(
    Tdata *nram_x,
    const Tdata *x,
    int offset,
    int chunk_elements) {

    __memcpy(nram_x, x + offset, chunk_elements * sizeof(Tdata), GDRAM2NRAM);
}

template <typename Tdata, bool UPPER, bool TRANS>
__mlu_func__ void loadTbmvAChunk(
    Tdata *nram_A,
    const Tdata *A,
    int lda,
    int bandwidth,
    int output_index,
    int input_offset,
    int chunk_elements) {

    if constexpr (TRANS) {
        if constexpr (UPPER) {
            __memcpy(
                nram_A,
                A + bandwidth + input_offset - output_index + output_index * lda,
                chunk_elements * sizeof(Tdata),
                GDRAM2NRAM);
        } else {
            for (int k = 0; k < chunk_elements; ++k) {
                int input_index = input_offset + k;
                nram_A[k] = A[input_index - output_index + output_index * lda];
            }
        }
    } else {
        if constexpr (UPPER) {
            for (int k = 0; k < chunk_elements; ++k) {
                int input_index = input_offset + k;
                nram_A[k] = A[bandwidth + output_index - input_index + input_index * lda];
            }
        } else {
            for (int k = 0; k < chunk_elements; ++k) {
                int input_index = input_offset + k;
                nram_A[k] = A[output_index - input_index + input_index * lda];
            }
        }
    }
}

template <typename Tdata, bool UPPER, bool TRANS>
__mlu_func__ Tdata computeTbmvChunk(
    Tdata *nram_A,
    Tdata *nram_x,
    const Tdata *A,
    int lda,
    int bandwidth,
    const Tdata *x_copy,
    int output_index,
    int input_offset,
    int chunk_elements) {

    loadTbmvAChunk<Tdata, UPPER, TRANS>(
        nram_A,
        A, lda, bandwidth,
        output_index,
        input_offset,
        chunk_elements);
    loadTbmvXChunk(nram_x, x_copy, input_offset, chunk_elements);

    __bang_mul(nram_A, nram_A, nram_x, chunk_elements);
    return __bang_sum(nram_A, chunk_elements);
}

template <typename Tdata, bool UPPER, bool TRANS, bool UNIT_DIAG>
__mlu_func__ void tbmvKernelImpl(
    int n, int k,
    const Tdata *A, int lda,
    const Tdata *x_copy,
    Tdata *x, int incx) {

    char *nram_aligned = (char *)(((size_t)nram_buffer + ALIGN_SIZE - 1) & ~(ALIGN_SIZE - 1));

    size_t nram_usable = NRAM_MAX_SIZE - (nram_aligned - nram_buffer);
    size_t max_chunk_elements = nram_usable / (2 * sizeof(Tdata));

    size_t align_elements = ALIGN_SIZE / sizeof(Tdata);
    if (align_elements == 0) {
        align_elements = 1;
    }
    int chunk_size = (int)((max_chunk_elements / align_elements) * align_elements);

    Tdata *nram_A = (Tdata *)nram_aligned;
    Tdata *nram_x = nram_A + chunk_size;

    int elements_per_core = n / taskDim;
    int remain = n % taskDim;
    int core_elements = elements_per_core + (taskId < remain ? 1 : 0);
    int core_offset = taskId < remain ? taskId * core_elements : taskId * elements_per_core + remain;

    if (core_elements <= 0) {
        return;
    }

    for (int i = core_offset; i < core_offset + core_elements; ++i) {
        int begin;
        int end;
        if constexpr (TRANS) {
            begin = UPPER ? (i > k ? i - k : 0) : i;
            end = UPPER ? i + 1 : (i + k + 1 < n ? i + k + 1 : n);
        } else {
            begin = UPPER ? i : (i > k ? i - k : 0);
            end = UPPER ? (i + k + 1 < n ? i + k + 1 : n) : i + 1;
        }

        Tdata sum;
        if constexpr (UNIT_DIAG) {
            sum = x_copy[i];
            if constexpr ((!TRANS && UPPER) || (TRANS && !UPPER)) {
                begin++;
            } else {
                end--;
            }
        } else {
            sum = 0;
        }

        int elements = end - begin;
        int chunks = elements / chunk_size;
        int chunk_rem = elements % chunk_size;

        for (int c = 0; c < chunks; ++c) {
            int current_offset = begin + c * chunk_size;
            sum += computeTbmvChunk<Tdata, UPPER, TRANS>(
                nram_A,
                nram_x,
                A, lda, k,
                x_copy,
                i,
                current_offset,
                chunk_size);
        }

        if (chunk_rem > 0) {
            int current_offset = begin + chunks * chunk_size;
            sum += computeTbmvChunk<Tdata, UPPER, TRANS>(
                nram_A,
                nram_x,
                A, lda, k,
                x_copy,
                i,
                current_offset,
                chunk_rem);
        }

        x[i * incx] = sum;
    }
}

#define DISPATCH_TBMV(UPPER, TRANS, UNIT) \
    tbmvKernelImpl<Tdata, UPPER, TRANS, UNIT>(n, k, A, lda, x_copy, x, incx)

template <typename Tdata>
__mlu_global__ void tbmvKernel(
    infiniopBlasFillMode_t uplo,
    infiniopBlasOperation_t trans,
    infiniopBlasDiagType_t diag,
    int n, int k,
    const Tdata *A, int lda,
    const Tdata *x_copy,
    Tdata *x, int incx) {

    const bool upper = uplo == INFINIOP_BLAS_FILL_MODE_UPPER;
    const bool transposed = trans == INFINIOP_BLAS_OP_T;
    const bool unit_diag = diag == INFINIOP_BLAS_DIAG_UNIT;

    if (transposed) {
        if (unit_diag) {
            if (upper) {
                DISPATCH_TBMV(true, true, true);
            } else {
                DISPATCH_TBMV(false, true, true);
            }
        } else {
            if (upper) {
                DISPATCH_TBMV(true, true, false);
            } else {
                DISPATCH_TBMV(false, true, false);
            }
        }
    } else {
        if (unit_diag) {
            if (upper) {
                DISPATCH_TBMV(true, false, true);
            } else {
                DISPATCH_TBMV(false, false, true);
            }
        } else {
            if (upper) {
                DISPATCH_TBMV(true, false, false);
            } else {
                DISPATCH_TBMV(false, false, false);
            }
        }
    }

#undef DISPATCH_TBMV
}
