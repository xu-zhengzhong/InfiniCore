#include "../../../devices/bang/common_bang.h"
#include "tbmv_bang.h"
#include "tbmv_bang_kernel.mlu"

namespace op::tbmv::bang {

Descriptor::~Descriptor() = default;

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopBlasFillMode_t uplo,
    infiniopBlasOperation_t trans,
    infiniopBlasDiagType_t diag,
    size_t k,
    infiniopTensorDescriptor_t A_desc,
    infiniopTensorDescriptor_t x_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = TbmvInfo::createTbmvInfo(uplo, trans, diag, k, A_desc, x_desc);
    CHECK_RESULT(result);

    auto info = result.take();
    auto workspace_size = info.n * infiniSizeOf(info.data_type);

    *desc_ptr = new Descriptor(
        info,
        workspace_size,
        nullptr,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

template <typename Tdata>
infiniStatus_t calculateTbmv(
    const TbmvInfo &info,
    void *workspace,
    size_t workspace_size,
    const Tdata *A,
    Tdata *x,
    cnrtQueue_t queue) {

    CHECK_OR_RETURN(workspace_size >= info.n * sizeof(Tdata), INFINI_STATUS_INSUFFICIENT_WORKSPACE);

    const int n = utils::cast<int>(info.n);
    const int k = utils::cast<int>(info.k);
    const int incx = utils::cast<int>(info.incx);
    const int lda = utils::cast<int>(info.A_col_stride);

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = 4;
    k_dim.y = 1;
    k_dim.z = 1;
    k_type = cnrtFuncTypeUnion1;

    auto x_copy = reinterpret_cast<Tdata *>(workspace);
    tbmvCopyKernel<Tdata><<<k_dim, k_type, queue>>>(n, x, incx, x_copy);
    tbmvKernel<Tdata><<<k_dim, k_type, queue>>>(
        info.uplo,
        info.trans,
        info.diag,
        n, k,
        A, lda,
        x_copy,
        x, incx);

    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

#define CALCULATE_TBMV(TDATA)       \
    calculateTbmv(_info,            \
                  workspace,        \
                  workspace_size,   \
                  (const TDATA *)A, \
                  (TDATA *)x,       \
                  (cnrtQueue_t)stream)

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *A,
    void *x,
    void *stream) const {

    switch (_info.data_type) {
    case INFINI_DTYPE_F32:
        return CALCULATE_TBMV(float);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

#undef CALCULATE_TBMV

} // namespace op::tbmv::bang
