#include "../../../devices/bang/common_bang.h"
#include "trmm_bang.h"
#include "trmm_bang_kernel.mlu"

#include <algorithm>
#include <cstdlib>

namespace {

struct TrmmTileConfig {
    int rows;
    int cols;
};

bool betterEnoughTile(
    int rows,
    int cols,
    int m,
    int n,
    int tile_count,
    const TrmmTileConfig &best) {

    const int effective_area = std::min(rows, m) * std::min(cols, n);
    const int best_effective_area = std::min(best.rows, m) * std::min(best.cols, n);
    if (effective_area != best_effective_area) {
        return effective_area > best_effective_area;
    }

    const int waste = rows * cols - effective_area;
    const int best_waste = best.rows * best.cols - best_effective_area;
    if (waste != best_waste) {
        return waste < best_waste;
    }

    const int aspect_delta = std::abs(rows * n - cols * m);
    const int best_aspect_delta = std::abs(best.rows * n - best.cols * m);
    if (aspect_delta != best_aspect_delta) {
        return aspect_delta < best_aspect_delta;
    }

    const int best_tile_count = CEIL_DIV(m, best.rows) * CEIL_DIV(n, best.cols);
    return tile_count < best_tile_count;
}

bool betterParallelTile(
    int rows,
    int cols,
    int m,
    int n,
    int tile_count,
    const TrmmTileConfig &best) {

    const int best_tile_count = CEIL_DIV(m, best.rows) * CEIL_DIV(n, best.cols);
    if (tile_count != best_tile_count) {
        return tile_count > best_tile_count;
    }

    const int effective_area = std::min(rows, m) * std::min(cols, n);
    const int best_effective_area = std::min(best.rows, m) * std::min(best.cols, n);
    if (effective_area != best_effective_area) {
        return effective_area > best_effective_area;
    }

    const int waste = rows * cols - effective_area;
    const int best_waste = best.rows * best.cols - best_effective_area;
    return waste < best_waste;
}

TrmmTileConfig chooseTrmmTile(int m, int n, int task_count) {
    const TrmmTileConfig candidates[] = {
        {4, 4},
        {4, 8},
        {8, 4},
        {8, 8},
        {8, 16},
        {16, 8},
        {16, 16},
        {16, 32},
        {32, 16},
        {32, 32},
        {32, 64},
        {64, 32},
        {64, 64},
    };
    const int candidate_count = sizeof(candidates) / sizeof(candidates[0]);
    const int target_tiles = task_count > 0 ? task_count : 1;

    TrmmTileConfig best = candidates[0];
    bool has_enough_tiles = false;

    for (int candidate_idx = 0; candidate_idx < candidate_count; ++candidate_idx) {
        const int rows = candidates[candidate_idx].rows;
        const int cols = candidates[candidate_idx].cols;
        const int tile_count = CEIL_DIV(m, rows) * CEIL_DIV(n, cols);
        const bool enough_tiles = tile_count >= target_tiles;

        if (enough_tiles) {
            if (!has_enough_tiles || betterEnoughTile(rows, cols, m, n, tile_count, best)) {
                best = candidates[candidate_idx];
            }
            has_enough_tiles = true;
        } else if (!has_enough_tiles && betterParallelTile(rows, cols, m, n, tile_count, best)) {
            best = candidates[candidate_idx];
        }
    }

    return best;
}

template <typename Tdata>
void dispatchTrmmKernel(
    int task_count,
    cnrtDim3_t k_dim,
    cnrtFunctionType_t k_type,
    cnrtQueue_t queue,
    infiniopBlasSideMode_t side,
    infiniopBlasFillMode_t uplo,
    infiniopBlasOperation_t trans,
    infiniopBlasDiagType_t diag,
    int m,
    int n,
    const Tdata *alpha,
    const Tdata *A,
    int lda,
    const Tdata *B_copy,
    Tdata *B,
    int ldb) {

    const TrmmTileConfig tile = chooseTrmmTile(m, n, task_count);

#define LAUNCH_TRMM_TILE(TILE_ROWS, TILE_COLS) \
    trmmKernel<Tdata, TILE_ROWS, TILE_COLS><<<k_dim, k_type, queue>>>(side, uplo, trans, diag, m, n, alpha, A, lda, B_copy, B, ldb)

#define DISPATCH_TRMM_ROW_4()   \
    switch (tile.cols) {        \
    case 4:                     \
        LAUNCH_TRMM_TILE(4, 4); \
        break;                  \
    case 8:                     \
    default:                    \
        LAUNCH_TRMM_TILE(4, 8); \
        break;                  \
    }

#define DISPATCH_TRMM_ROW_8()    \
    switch (tile.cols) {         \
    case 4:                      \
        LAUNCH_TRMM_TILE(8, 4);  \
        break;                   \
    case 8:                      \
        LAUNCH_TRMM_TILE(8, 8);  \
        break;                   \
    case 16:                     \
    default:                     \
        LAUNCH_TRMM_TILE(8, 16); \
        break;                   \
    }

#define DISPATCH_TRMM_ROW_16()    \
    switch (tile.cols) {          \
    case 8:                       \
        LAUNCH_TRMM_TILE(16, 8);  \
        break;                    \
    case 16:                      \
        LAUNCH_TRMM_TILE(16, 16); \
        break;                    \
    case 32:                      \
    default:                      \
        LAUNCH_TRMM_TILE(16, 32); \
        break;                    \
    }

#define DISPATCH_TRMM_ROW_32()    \
    switch (tile.cols) {          \
    case 16:                      \
        LAUNCH_TRMM_TILE(32, 16); \
        break;                    \
    case 32:                      \
        LAUNCH_TRMM_TILE(32, 32); \
        break;                    \
    case 64:                      \
    default:                      \
        LAUNCH_TRMM_TILE(32, 64); \
        break;                    \
    }

#define DISPATCH_TRMM_ROW_64()    \
    switch (tile.cols) {          \
    case 32:                      \
        LAUNCH_TRMM_TILE(64, 32); \
        break;                    \
    case 64:                      \
    default:                      \
        LAUNCH_TRMM_TILE(64, 64); \
        break;                    \
    }

    switch (tile.rows) {
    case 4:
        DISPATCH_TRMM_ROW_4();
        break;
    case 8:
        DISPATCH_TRMM_ROW_8();
        break;
    case 16:
        DISPATCH_TRMM_ROW_16();
        break;
    case 32:
        DISPATCH_TRMM_ROW_32();
        break;
    case 64:
        DISPATCH_TRMM_ROW_64();
        break;
    default:
        DISPATCH_TRMM_ROW_32();
        break;
    }

#undef DISPATCH_TRMM_ROW_64
#undef DISPATCH_TRMM_ROW_32
#undef DISPATCH_TRMM_ROW_16
#undef DISPATCH_TRMM_ROW_8
#undef DISPATCH_TRMM_ROW_4
#undef LAUNCH_TRMM_TILE
}

} // namespace

namespace op::trmm::bang {

struct Descriptor::Opaque {
    std::shared_ptr<device::bang::Handle::Internal> internal;
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopBlasSideMode_t side,
    infiniopBlasFillMode_t uplo,
    infiniopBlasOperation_t trans,
    infiniopBlasDiagType_t diag,
    infiniopTensorDescriptor_t alpha_desc,
    infiniopTensorDescriptor_t A_desc,
    infiniopTensorDescriptor_t B_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = TrmmInfo::createTrmmInfo(side, uplo, trans, diag, alpha_desc, A_desc, B_desc);
    CHECK_RESULT(result);
    auto info = result.take();

    *desc_ptr = new Descriptor(
        info,
        info.m * info.n * infiniSizeOf(info.data_type),
        new Descriptor::Opaque{handle->internal()},
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

template <typename Tdata>
infiniStatus_t calculateTrmm(
    const TrmmInfo &info,
    void *workspace,
    size_t workspace_size,
    const Tdata *alpha,
    const Tdata *A,
    Tdata *B,
    int core_per_cluster,
    int cluster_count,
    cnrtQueue_t queue) {

    CHECK_OR_RETURN(workspace_size >= info.m * info.n * sizeof(Tdata), INFINI_STATUS_INSUFFICIENT_WORKSPACE);

    int m = utils::cast<int>(info.m);
    int n = utils::cast<int>(info.n);
    auto side = info.side;
    auto uplo = info.uplo;
    auto trans = info.trans;

    int lda = utils::cast<int>(info.A_col_stride);
    if (info.A_col_stride == 1) {
        lda = utils::cast<int>(info.A_row_stride);
        uplo = info.uplo == INFINIOP_BLAS_FILL_MODE_UPPER
                 ? INFINIOP_BLAS_FILL_MODE_LOWER
                 : INFINIOP_BLAS_FILL_MODE_UPPER;
        trans = info.trans == INFINIOP_BLAS_OP_N ? INFINIOP_BLAS_OP_T : INFINIOP_BLAS_OP_N;
    }

    const bool direct_layout = info.B_row_stride == 1;
    const bool transposed_layout = !direct_layout && info.B_col_stride == 1;
    CHECK_OR_RETURN(direct_layout || transposed_layout, INFINI_STATUS_BAD_TENSOR_STRIDES);

    int ldb = 0;
    if (direct_layout) {
        ldb = utils::cast<int>(info.B_col_stride);
    } else {
        ldb = utils::cast<int>(info.B_row_stride);
        side = info.side == INFINIOP_BLAS_SIDE_LEFT ? INFINIOP_BLAS_SIDE_RIGHT : INFINIOP_BLAS_SIDE_LEFT;
        trans = trans == INFINIOP_BLAS_OP_N ? INFINIOP_BLAS_OP_T : INFINIOP_BLAS_OP_N;
        const int tmp = m;
        m = n;
        n = tmp;
    }

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = core_per_cluster;
    k_dim.y = cluster_count;
    k_dim.z = 1;
    k_type = cnrtFuncTypeUnion1;

    auto B_copy = reinterpret_cast<Tdata *>(workspace);
    trmmCopyBKernel<Tdata><<<k_dim, k_type, queue>>>(m, n, B, ldb, B_copy);
    dispatchTrmmKernel<Tdata>(
        core_per_cluster * cluster_count,
        k_dim,
        k_type,
        queue,
        side,
        uplo,
        trans,
        info.diag,
        m,
        n,
        alpha,
        A,
        lda,
        B_copy,
        B,
        ldb);

    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

#define CALCULATE_TRMM(TDATA)           \
    calculateTrmm(_info,                \
                  workspace,            \
                  workspace_size,       \
                  (const TDATA *)alpha, \
                  (const TDATA *)A,     \
                  (TDATA *)B,           \
                  core_per_cluster,     \
                  cluster_count,        \
                  (cnrtQueue_t)stream)

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *alpha,
    const void *A,
    void *B,
    void *stream) const {

    int core_per_cluster = _opaque->internal->getCorePerCluster();
    int cluster_count = _opaque->internal->getClusterCount();

    switch (_info.data_type) {
    case INFINI_DTYPE_F32:
        return CALCULATE_TRMM(float);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

#undef CALCULATE_TRMM

} // namespace op::trmm::bang
