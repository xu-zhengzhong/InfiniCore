#include "../../blas_cnnl_bang.h"
#include "gemv_bang.h"

namespace op::gemv::bang {

struct Descriptor::Opaque {
    blas_cnnl::bang::TensorDescriptor a;
    blas_cnnl::bang::TensorDescriptor x;
    blas_cnnl::bang::TensorDescriptor y;
    blas_cnnl::bang::MatMulDescriptor op;
    blas_cnnl::bang::MatMulAlgo algo;
    blas_cnnl::bang::MatMulHeuristicResult heuristic;
    std::shared_ptr<device::bang::Handle::Internal> internal;
    size_t matmul_workspace_size = 0;
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopBlasOperation_t trans,
    infiniopTensorDescriptor_t alpha_desc,
    infiniopTensorDescriptor_t A_desc,
    infiniopTensorDescriptor_t x_desc,
    infiniopTensorDescriptor_t beta_desc,
    infiniopTensorDescriptor_t y_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = GemvInfo::createGemvInfo(trans, alpha_desc, A_desc, x_desc, beta_desc, y_desc);
    CHECK_RESULT(result);
    auto info = result.take();

    if (info.data_type != INFINI_DTYPE_F32) {
        *desc_ptr = new Descriptor(
            info,
            0,
            nullptr,
            handle->device,
            handle->device_id);
        return INFINI_STATUS_SUCCESS;
    }

    auto opaque = new Opaque{};
    opaque->internal = handle->internal();

    const bool row_major_a = info.A_col_stride == 1;
    bool trans_a = false;
    int lda = 0;

    if (row_major_a) {
        trans_a = info.trans == INFINIOP_BLAS_OP_T;
        lda = utils::cast<int>(blas_cnnl::bang::positiveStride(info.A_row_stride));
        CHECK_STATUS(blas_cnnl::bang::setMatrixTensor(
            opaque->a,
            info.m,
            info.n,
            info.A_row_stride,
            info.A_col_stride,
            info.data_type));
    } else {
        trans_a = info.trans == INFINIOP_BLAS_OP_N;
        lda = utils::cast<int>(blas_cnnl::bang::positiveStride(info.A_col_stride));
        CHECK_STATUS(blas_cnnl::bang::setMatrixTensor(
            opaque->a,
            info.n,
            info.m,
            info.A_col_stride,
            info.A_row_stride,
            info.data_type));
    }

    const size_t x_len = info.trans == INFINIOP_BLAS_OP_N ? info.n : info.m;
    const size_t y_len = info.trans == INFINIOP_BLAS_OP_N ? info.m : info.n;
    const int ldb = utils::cast<int>(blas_cnnl::bang::positiveStride(info.incx));
    const int ldc = utils::cast<int>(blas_cnnl::bang::positiveStride(info.incy));
    CHECK_STATUS(blas_cnnl::bang::setMatrixTensor(
        opaque->x,
        x_len,
        1,
        info.incx,
        1,
        info.data_type));
    CHECK_STATUS(blas_cnnl::bang::setMatrixTensor(
        opaque->y,
        y_len,
        1,
        info.incy,
        1,
        info.data_type));

    CHECK_STATUS(opaque->op.create(trans_a, false, true, lda, ldb, ldc));
    CHECK_STATUS(blas_cnnl::bang::initMatMulAlgo(
        opaque->internal,
        opaque->op,
        opaque->a,
        opaque->x,
        opaque->y,
        opaque->y,
        opaque->algo,
        opaque->heuristic,
        &opaque->matmul_workspace_size));

    *desc_ptr = new Descriptor(
        info,
        opaque->matmul_workspace_size,
        opaque,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *alpha,
    const void *A,
    const void *x,
    const void *beta,
    void *y,
    void *stream) const {

    if (_info.data_type != INFINI_DTYPE_F32) {
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }

    CHECK_OR_RETURN(_opaque != nullptr, INFINI_STATUS_INTERNAL_ERROR);
    CHECK_OR_RETURN(workspace_size >= workspaceSize(), INFINI_STATUS_INSUFFICIENT_WORKSPACE);
    CHECK_OR_RETURN(workspace != nullptr || workspaceSize() == 0, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(alpha != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(A != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(x != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(beta != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(y != nullptr, INFINI_STATUS_NULL_POINTER);

    float alpha_value = 0.0f;
    float beta_value = 0.0f;
    CHECK_STATUS(blas_cnnl::bang::copyScalarToFloat(&alpha_value, alpha, _info.data_type, (cnrtQueue_t)stream));
    CHECK_STATUS(blas_cnnl::bang::copyScalarToFloat(&beta_value, beta, _info.data_type, (cnrtQueue_t)stream));

    const void *A_ptr = blas_cnnl::bang::logicalMatrixPtr(
        A,
        _info.m,
        _info.n,
        _info.A_row_stride,
        _info.A_col_stride,
        _info.data_type);
    const void *x_ptr = blas_cnnl::bang::logicalVectorPtr(x, _info.n, _info.incx, _info.data_type);
    if (_info.trans == INFINIOP_BLAS_OP_T) {
        x_ptr = blas_cnnl::bang::logicalVectorPtr(x, _info.m, _info.incx, _info.data_type);
    }
    void *y_ptr = blas_cnnl::bang::logicalVectorPtr(y, _info.trans == INFINIOP_BLAS_OP_N ? _info.m : _info.n, _info.incy, _info.data_type);

    CHECK_STATUS(blas_cnnl::bang::cnnlMatMul(
        _opaque->internal,
        (cnrtQueue_t)stream,
        _opaque->op,
        _opaque->algo,
        alpha_value,
        _opaque->a,
        A_ptr,
        _opaque->x,
        x_ptr,
        beta_value,
        _opaque->y,
        y_ptr,
        workspace,
        workspace_size,
        _opaque->y,
        y_ptr));
    CHECK_STATUS(blas_cnnl::bang::syncQueue((cnrtQueue_t)stream));

    return INFINI_STATUS_SUCCESS;
}

} // namespace op::gemv::bang
