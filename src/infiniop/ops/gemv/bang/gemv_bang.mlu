#include "../../../devices/bang/common_bang.h"
#include "gemv_bang.h"
#include "gemv_bang_kernel.mlu"

namespace op::gemv::bang {

Descriptor::~Descriptor() = default;

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopBlasOperation_t trans,
    infiniopTensorDescriptor_t alpha_desc,
    infiniopTensorDescriptor_t A_desc,
    infiniopTensorDescriptor_t x_desc,
    infiniopTensorDescriptor_t beta_desc,
    infiniopTensorDescriptor_t y_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = GemvInfo::createGemvInfo(trans, alpha_desc, A_desc, x_desc, beta_desc, y_desc);
    CHECK_RESULT(result);

    *desc_ptr = new Descriptor(
        result.take(),
        0,
        nullptr,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

template <typename Tdata>
infiniStatus_t calculateGemv(
    const GemvInfo &info,
    const Tdata *alpha,
    const Tdata *A,
    const Tdata *x,
    const Tdata *beta,
    Tdata *y,
    cnrtQueue_t queue) {

    int m = utils::cast<int>(info.m);
    int n = utils::cast<int>(info.n);
    const int incx = utils::cast<int>(info.incx);
    const int incy = utils::cast<int>(info.incy);
    const int A_row_stride = utils::cast<int>(info.A_row_stride);
    const int A_col_stride = utils::cast<int>(info.A_col_stride);

    auto trans = info.trans;
    auto lda = A_col_stride;

    // Row-major tensors are interpreted as column-major transposed matrices.
    if (A_col_stride == 1) {
        trans = info.trans == INFINIOP_BLAS_OP_N ? INFINIOP_BLAS_OP_T : INFINIOP_BLAS_OP_N;
        lda = A_row_stride;
        std::swap(m, n);
    }

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = 4;
    k_dim.y = 1;
    k_dim.z = 1;
    k_type = cnrtFuncTypeUnion1;

    gemvKernel<Tdata><<<k_dim, k_type, queue>>>(
        trans,
        m, n,
        alpha,
        A, lda,
        x, incx,
        beta,
        y, incy);

    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

#define CALCULATE_GEMV(TDATA)           \
    calculateGemv(_info,                \
                  (const TDATA *)alpha, \
                  (const TDATA *)A,     \
                  (const TDATA *)x,     \
                  (const TDATA *)beta,  \
                  (TDATA *)y,           \
                  (cnrtQueue_t)stream)

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *alpha,
    const void *A,
    const void *x,
    const void *beta,
    void *y,
    void *stream) const {

    (void)workspace;
    (void)workspace_size;

    switch (_info.data_type) {
    case INFINI_DTYPE_F32:
        return CALCULATE_GEMV(float);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

#undef CALCULATE_GEMV

} // namespace op::gemv::bang
