#include "../../../devices/bang/common_bang.h"
#include "gemv_bang.h"

__nram__ char nram_buffer[NRAM_MAX_SIZE];

template <typename Tdata, bool X_CONTIGUOUS>
__mlu_func__ void loadGemvXChunk(
    Tdata *nram_x,
    const Tdata *x,
    int offset,
    int incx,
    int chunk_elements) {

    if constexpr (X_CONTIGUOUS) {
        __memcpy(nram_x, x + offset, chunk_elements * sizeof(Tdata), GDRAM2NRAM);
    } else {
        for (int i = 0; i < chunk_elements; i++) {
            nram_x[i] = x[(offset + i) * incx];
        }
    }
}

template <typename Tdata, bool X_CONTIGUOUS>
__mlu_func__ void gemvKernelImpl(
    bool transposed,
    int m, int n,
    const Tdata *alpha,
    const Tdata *A, int lda,
    const Tdata *x, int incx,
    const Tdata *beta,
    Tdata *y, int incy) {

    char *nram_aligned = (char *)(((size_t)nram_buffer + ALIGN_SIZE - 1) & ~(ALIGN_SIZE - 1));

    size_t nram_usable = NRAM_MAX_SIZE - (nram_aligned - nram_buffer);
    size_t max_chunk_elements = nram_usable / (2 * sizeof(Tdata));

    size_t align_elements = ALIGN_SIZE / sizeof(Tdata);
    if (align_elements == 0) {
        align_elements = 1;
    }
    int chunk_size = (int)((max_chunk_elements / align_elements) * align_elements);

    Tdata *nram_A = (Tdata *)nram_aligned;
    Tdata *nram_x = nram_A + chunk_size;

    if (transposed) {
        int temp = m;
        m = n;
        n = temp;
    }

    int elements_per_core = m / taskDim;
    int remain = m % taskDim;
    int core_elements = elements_per_core + (taskId < remain ? 1 : 0);
    int core_offset = taskId < remain ? taskId * core_elements : taskId * elements_per_core + remain;

    if (core_elements <= 0) {
        return;
    }

    int chunks = n / chunk_size;
    int chunk_rem = n % chunk_size;

    if (!transposed) {
        for (int i = core_offset; i < core_offset + core_elements; i++) {
            Tdata sum = 0;

            for (int c = 0; c < chunks; c++) {
                int current_offset = c * chunk_size;

                for (int j = 0; j < chunk_size; j++) {
                    nram_A[j] = A[i + (current_offset + j) * lda];
                }
                loadGemvXChunk<Tdata, X_CONTIGUOUS>(nram_x, x, current_offset, incx, chunk_size);

                __bang_mul(nram_A, nram_A, nram_x, chunk_size);
                sum += __bang_sum(nram_A, chunk_size);
            }

            if (chunk_rem > 0) {
                int current_offset = chunks * chunk_size;

                for (int j = 0; j < chunk_rem; j++) {
                    nram_A[j] = A[i + (current_offset + j) * lda];
                }
                loadGemvXChunk<Tdata, X_CONTIGUOUS>(nram_x, x, current_offset, incx, chunk_rem);

                __bang_mul(nram_A, nram_A, nram_x, chunk_rem);
                sum += __bang_sum(nram_A, chunk_rem);
            }

            y[i * incy] = (*alpha) * sum + (*beta) * y[i * incy];
        }
    } else {
        for (int i = core_offset; i < core_offset + core_elements; i++) {
            Tdata sum = 0;

            for (int c = 0; c < chunks; c++) {
                int current_offset = c * chunk_size;

                __memcpy(nram_A, A + current_offset + i * lda, chunk_size * sizeof(Tdata), GDRAM2NRAM);
                loadGemvXChunk<Tdata, X_CONTIGUOUS>(nram_x, x, current_offset, incx, chunk_size);

                __bang_mul(nram_A, nram_A, nram_x, chunk_size);
                sum += __bang_sum(nram_A, chunk_size);
            }

            if (chunk_rem > 0) {
                int current_offset = chunks * chunk_size;

                __memcpy(nram_A, A + current_offset + i * lda, chunk_rem * sizeof(Tdata), GDRAM2NRAM);
                loadGemvXChunk<Tdata, X_CONTIGUOUS>(nram_x, x, current_offset, incx, chunk_rem);

                __bang_mul(nram_A, nram_A, nram_x, chunk_rem);
                sum += __bang_sum(nram_A, chunk_rem);
            }

            y[i * incy] = (*alpha) * sum + (*beta) * y[i * incy];
        }
    }
}

#define DISPATCH_GEMV(CONTIG) \
    gemvKernelImpl<Tdata, CONTIG>(transposed, m, n, alpha, A, lda, x, incx, beta, y, incy)

template <typename Tdata>
__mlu_global__ void gemvKernel(
    infiniopBlasOperation_t trans,
    int m, int n,
    const Tdata *alpha,
    const Tdata *A, int lda,
    const Tdata *x, int incx,
    const Tdata *beta,
    Tdata *y, int incy) {

    const bool transposed = trans == INFINIOP_BLAS_OP_T;
    const bool x_contiguous = incx == 1;

    if (x_contiguous) {
        DISPATCH_GEMV(true);
    } else {
        DISPATCH_GEMV(false);
    }

#undef DISPATCH_GEMV
}
