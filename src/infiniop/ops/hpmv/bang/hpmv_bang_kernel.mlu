#include "../../../devices/bang/bang_complex.h"
#include "../../../devices/bang/common_bang.h"
#include "hpmv_bang.h"

__nram__ char nram_buffer[NRAM_MAX_SIZE];

template <bool UPPER>
__mlu_func__ void loadHpmvAPChunk(
    int row,
    int n,
    int offset,
    int len,
    const device::bang::Complex *AP,
    float *AP_real,
    float *AP_imag) {

    for (int k = 0; k < len; ++k) {
        const int col = offset + k;
        device::bang::Complex value;

        if (row == col) {
            int AP_idx;
            if constexpr (UPPER) {
                AP_idx = col * (col + 1) / 2 + row;
            } else {
                AP_idx = col * n - col * (col - 1) / 2;
            }
            value = device::bang::makeFloatComplex(device::bang::cReal(AP[AP_idx]), 0.0f);
        } else if constexpr (UPPER) {
            if (row < col) {
                const int AP_idx = col * (col + 1) / 2 + row;
                value = AP[AP_idx];
            } else {
                const int AP_idx = row * (row + 1) / 2 + col;
                value = device::bang::cConj(AP[AP_idx]);
            }
        } else {
            if (row > col) {
                const int AP_idx = col * n - col * (col - 1) / 2 + (row - col);
                value = AP[AP_idx];
            } else {
                const int AP_idx = row * n - row * (row - 1) / 2 + (col - row);
                value = device::bang::cConj(AP[AP_idx]);
            }
        }

        AP_real[k] = device::bang::cReal(value);
        AP_imag[k] = device::bang::cImag(value);
    }
}

template <bool X_CONTIGUOUS>
__mlu_func__ void loadHpmvXChunk(
    int offset,
    int len,
    const device::bang::Complex *x,
    int incx,
    float *x_real,
    float *x_imag) {

    for (int k = 0; k < len; ++k) {
        const auto value = x[X_CONTIGUOUS ? offset + k : (offset + k) * incx];
        x_real[k] = device::bang::cReal(value);
        x_imag[k] = device::bang::cImag(value);
    }
}

template <bool UPPER, bool X_CONTIGUOUS>
__mlu_device__ void hpmvKernelImpl(
    int n,
    const device::bang::Complex *alpha,
    const device::bang::Complex *AP,
    const device::bang::Complex *x,
    int incx,
    const device::bang::Complex *beta,
    device::bang::Complex *y,
    int incy) {

    char *nram_aligned = (char *)(((size_t)nram_buffer + ALIGN_SIZE - 1) & ~(ALIGN_SIZE - 1));

    size_t nram_usable = NRAM_MAX_SIZE - (nram_aligned - nram_buffer);
    size_t max_chunk_elements = nram_usable / (5 * sizeof(float));

    size_t align_elements = ALIGN_SIZE / sizeof(float);
    if (align_elements == 0) {
        align_elements = 1;
    }
    int chunk_size = (int)((max_chunk_elements / align_elements) * align_elements);

    float *nram_AP_real = (float *)nram_aligned;
    float *nram_AP_imag = nram_AP_real + chunk_size;
    float *nram_x_real = nram_AP_imag + chunk_size;
    float *nram_x_imag = nram_x_real + chunk_size;
    float *nram_prod = nram_x_imag + chunk_size;

    const auto alpha_v = alpha[0];
    const auto beta_v = beta[0];

    int elements_per_core = n / taskDim;
    int remain = n % taskDim;
    int core_elements = elements_per_core + (taskId < remain ? 1 : 0);
    int core_offset = taskId < remain ? taskId * core_elements : taskId * elements_per_core + remain;

    if (core_elements <= 0) {
        return;
    }

    const int chunks = n / chunk_size;
    const int chunk_rem = n % chunk_size;

    for (int i = core_offset; i < core_offset + core_elements; ++i) {
        if (device::bang::cIsZero(alpha_v)) {
            if (device::bang::cIsZero(beta_v)) {
                y[i * incy] = device::bang::makeFloatComplex(0.0f, 0.0f);
            } else if (!device::bang::cIsOne(beta_v)) {
                y[i * incy] = device::bang::cMul(beta_v, y[i * incy]);
            }
            continue;
        }

        float sum_real = 0.0f;
        float sum_imag = 0.0f;

        for (int c = 0; c < chunks; ++c) {
            const int current_offset = c * chunk_size;

            loadHpmvAPChunk<UPPER>(
                i, n, current_offset, chunk_size,
                AP, nram_AP_real, nram_AP_imag);
            loadHpmvXChunk<X_CONTIGUOUS>(
                current_offset, chunk_size,
                x, incx,
                nram_x_real, nram_x_imag);

            __bang_mul(nram_prod, nram_AP_real, nram_x_real, chunk_size);
            sum_real += __bang_sum(nram_prod, chunk_size);
            __bang_mul(nram_prod, nram_AP_imag, nram_x_imag, chunk_size);
            sum_real -= __bang_sum(nram_prod, chunk_size);

            __bang_mul(nram_prod, nram_AP_real, nram_x_imag, chunk_size);
            sum_imag += __bang_sum(nram_prod, chunk_size);
            __bang_mul(nram_prod, nram_AP_imag, nram_x_real, chunk_size);
            sum_imag += __bang_sum(nram_prod, chunk_size);
        }

        if (chunk_rem > 0) {
            const int current_offset = chunks * chunk_size;

            loadHpmvAPChunk<UPPER>(
                i, n, current_offset, chunk_rem,
                AP, nram_AP_real, nram_AP_imag);
            loadHpmvXChunk<X_CONTIGUOUS>(
                current_offset, chunk_rem,
                x, incx,
                nram_x_real, nram_x_imag);

            __bang_mul(nram_prod, nram_AP_real, nram_x_real, chunk_rem);
            sum_real += __bang_sum(nram_prod, chunk_rem);
            __bang_mul(nram_prod, nram_AP_imag, nram_x_imag, chunk_rem);
            sum_real -= __bang_sum(nram_prod, chunk_rem);

            __bang_mul(nram_prod, nram_AP_real, nram_x_imag, chunk_rem);
            sum_imag += __bang_sum(nram_prod, chunk_rem);
            __bang_mul(nram_prod, nram_AP_imag, nram_x_real, chunk_rem);
            sum_imag += __bang_sum(nram_prod, chunk_rem);
        }

        const auto y_v = y[i * incy];
        const auto sum_v = device::bang::makeFloatComplex(sum_real, sum_imag);
        const auto alpha_sum = device::bang::cMul(alpha_v, sum_v);

        if (device::bang::cIsZero(beta_v)) {
            y[i * incy] = alpha_sum;
        } else if (device::bang::cIsOne(beta_v)) {
            y[i * incy] = device::bang::cAdd(alpha_sum, y_v);
        } else {
            y[i * incy] = device::bang::cAdd(alpha_sum, device::bang::cMul(beta_v, y_v));
        }
    }
}

#define DISPATCH_HPMV(UPPER, CONTIG) \
    hpmvKernelImpl<UPPER, CONTIG>(n, alpha, AP, x, incx, beta, y, incy)

__mlu_global__ void hpmvKernel(
    infiniopBlasFillMode_t uplo,
    int n,
    const device::bang::Complex *alpha,
    const device::bang::Complex *AP,
    const device::bang::Complex *x,
    int incx,
    const device::bang::Complex *beta,
    device::bang::Complex *y,
    int incy) {

    const bool upper = uplo == INFINIOP_BLAS_FILL_MODE_UPPER;
    const bool x_contiguous = incx == 1;

    if (upper) {
        if (x_contiguous) {
            DISPATCH_HPMV(true, true);
        } else {
            DISPATCH_HPMV(true, false);
        }
    } else {
        if (x_contiguous) {
            DISPATCH_HPMV(false, true);
        } else {
            DISPATCH_HPMV(false, false);
        }
    }

#undef DISPATCH_HPMV
}
