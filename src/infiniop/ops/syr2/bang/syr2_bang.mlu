#include "../../../devices/bang/common_bang.h"
#include "syr2_bang.h"
#include "syr2_bang_kernel.mlu"

namespace op::syr2::bang {

Descriptor::~Descriptor() = default;

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopBlasFillMode_t uplo,
    infiniopTensorDescriptor_t alpha_desc,
    infiniopTensorDescriptor_t x_desc,
    infiniopTensorDescriptor_t y_desc,
    infiniopTensorDescriptor_t A_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = Syr2Info::createSyr2Info(uplo, alpha_desc, x_desc, y_desc, A_desc);
    CHECK_RESULT(result);

    *desc_ptr = new Descriptor(
        result.take(),
        0,
        nullptr,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

template <typename Tdata>
infiniStatus_t calculateSyr2(
    const Syr2Info &info,
    const Tdata *alpha,
    const Tdata *x,
    const Tdata *y,
    Tdata *A,
    cnrtQueue_t queue) {

    const int n = utils::cast<int>(info.n);
    const int incx = utils::cast<int>(info.incx);
    const int incy = utils::cast<int>(info.incy);
    auto uplo = info.uplo;
    auto lda = utils::cast<int>(info.A_col_stride);

    // Row-major tensors are interpreted as column-major transposed matrices.
    if (info.A_col_stride == 1) {
        uplo = info.uplo == INFINIOP_BLAS_FILL_MODE_UPPER ? INFINIOP_BLAS_FILL_MODE_LOWER : INFINIOP_BLAS_FILL_MODE_UPPER;
        lda = utils::cast<int>(info.A_row_stride);
    }

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = 4;
    k_dim.y = 1;
    k_dim.z = 1;
    k_type = cnrtFuncTypeUnion1;

    syr2Kernel<Tdata><<<k_dim, k_type, queue>>>(
        uplo,
        n,
        alpha,
        x, incx,
        y, incy,
        A, lda);

    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

#define CALCULATE_SYR2(TDATA)           \
    calculateSyr2(_info,                \
                  (const TDATA *)alpha, \
                  (const TDATA *)x,     \
                  (const TDATA *)y,     \
                  (TDATA *)A,           \
                  (cnrtQueue_t)stream)

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *alpha,
    const void *x,
    const void *y,
    void *A,
    void *stream) const {

    (void)workspace;
    (void)workspace_size;

    switch (_info.data_type) {
    case INFINI_DTYPE_F32:
        return CALCULATE_SYR2(float);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

#undef CALCULATE_SYR2

} // namespace op::syr2::bang
