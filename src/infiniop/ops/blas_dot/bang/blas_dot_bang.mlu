#include "../../blas_cnnl_bang.h"
#include "blas_dot_bang.h"

namespace op::blas_dot::bang {

namespace {

bool isSupported(infiniDtype_t dtype) {
    return dtype == INFINI_DTYPE_F16
        || dtype == INFINI_DTYPE_BF16
        || dtype == INFINI_DTYPE_F32;
}

} // namespace

struct Descriptor::Opaque {
    blas_cnnl::bang::TensorDescriptor x;
    blas_cnnl::bang::TensorDescriptor y;
    blas_cnnl::bang::TensorDescriptor product;
    blas_cnnl::bang::TensorDescriptor result;
    blas_cnnl::bang::OpTensorDescriptor mul;
    blas_cnnl::bang::ReduceDescriptor reduce;
    std::shared_ptr<device::bang::Handle::Internal> internal;
    size_t product_workspace_size = 0;
    size_t mul_workspace_size = 0;
    size_t reduce_workspace_size = 0;
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopTensorDescriptor_t x_desc,
    infiniopTensorDescriptor_t y_desc,
    infiniopTensorDescriptor_t result_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = BlasDotInfo::createBlasDotInfo(x_desc, y_desc, result_desc);
    CHECK_RESULT(result);
    auto info = result.take();

    if (!isSupported(info.data_type)) {
        *desc_ptr = new Descriptor(
            info,
            0,
            nullptr,
            handle->device,
            handle->device_id);
        return INFINI_STATUS_SUCCESS;
    }

    auto opaque = new Opaque{};
    opaque->internal = handle->internal();
    opaque->product_workspace_size = blas_cnnl::bang::vectorBytes(info.n, info.data_type);

    CHECK_STATUS(blas_cnnl::bang::setVectorTensor(opaque->x, info.n, info.incx, info.data_type));
    CHECK_STATUS(blas_cnnl::bang::setVectorTensor(opaque->y, info.n, info.incy, info.data_type));
    CHECK_STATUS(blas_cnnl::bang::setContiguousVectorTensor(opaque->product, info.n, info.data_type));
    CHECK_STATUS(blas_cnnl::bang::setScalarTensor(opaque->result, info.data_type));
    CHECK_STATUS(opaque->mul.create(CNNL_OP_TENSOR_MUL));
    CHECK_STATUS(opaque->reduce.create(CNNL_REDUCE_ADD));
    CHECK_STATUS(blas_cnnl::bang::getOpTensorWorkspaceSize(
        opaque->internal,
        opaque->x,
        opaque->y,
        opaque->product,
        &opaque->mul_workspace_size));
    CHECK_STATUS(blas_cnnl::bang::getReduceWorkspaceSize(
        opaque->internal,
        opaque->product,
        opaque->result,
        opaque->reduce,
        &opaque->reduce_workspace_size));

    const size_t workspace_size = opaque->product_workspace_size
                                + std::max(opaque->mul_workspace_size, opaque->reduce_workspace_size);

    *desc_ptr = new Descriptor(
        info,
        workspace_size,
        opaque,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *x,
    const void *y,
    void *result,
    void *stream) const {

    if (!isSupported(_info.data_type)) {
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }

    CHECK_OR_RETURN(_opaque != nullptr, INFINI_STATUS_INTERNAL_ERROR);
    CHECK_OR_RETURN(workspace_size >= workspaceSize(), INFINI_STATUS_INSUFFICIENT_WORKSPACE);
    CHECK_OR_RETURN(workspace != nullptr || workspaceSize() == 0, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(x != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(y != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(result != nullptr, INFINI_STATUS_NULL_POINTER);

    void *product = workspace;
    void *op_workspace = blas_cnnl::bang::workspaceAt(workspace, _opaque->product_workspace_size);
    const size_t op_workspace_size = workspace_size - _opaque->product_workspace_size;
    const void *x_ptr = blas_cnnl::bang::logicalVectorPtr(x, _info.n, _info.incx, _info.data_type);
    const void *y_ptr = blas_cnnl::bang::logicalVectorPtr(y, _info.n, _info.incy, _info.data_type);

    CHECK_STATUS(blas_cnnl::bang::cnnlOpTensor(
        _opaque->internal,
        (cnrtQueue_t)stream,
        _opaque->mul,
        1.0f,
        _opaque->x,
        x_ptr,
        1.0f,
        _opaque->y,
        y_ptr,
        op_workspace,
        op_workspace_size,
        0.0f,
        _opaque->product,
        product));
    CHECK_STATUS(blas_cnnl::bang::cnnlReduce(
        _opaque->internal,
        (cnrtQueue_t)stream,
        _opaque->reduce,
        _opaque->product,
        product,
        op_workspace,
        op_workspace_size,
        _opaque->result,
        result));
    CHECK_STATUS(blas_cnnl::bang::syncQueue((cnrtQueue_t)stream));

    return INFINI_STATUS_SUCCESS;
}

} // namespace op::blas_dot::bang
