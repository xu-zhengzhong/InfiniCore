#include "../../../devices/bang/common_bang.h"

__mlu_global__ void axpbyF32Kernel(
    int n,
    int incx,
    int incy,
    const float *x,
    float *y,
    float alpha,
    float beta) {
    for (int i = taskId; i < n; i += taskDim) {
        int x_offset = i * incx;
        int y_offset = i * incy;
        y[y_offset] = alpha * x[x_offset] + beta * y[y_offset];
    }
}
