#include "../../../devices/bang/common_bang.h"
#include "axpby_bang.h"
#include "axpby_bang_kernel.mlu"

namespace op::axpby::bang {

struct Descriptor::Opaque {
    std::shared_ptr<device::bang::Handle::Internal> internal;
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopSpVecDescriptor_t x_desc,
    infiniopTensorDescriptor_t y_desc) {
    auto handle = reinterpret_cast<device::bang::cambricon::Handle *>(handle_);
    CHECK_DTYPE(x_desc->valuesDesc()->dtype(), INFINI_DTYPE_F32);
    CHECK_DTYPE(x_desc->indicesDesc()->dtype(), INFINI_DTYPE_I32, INFINI_DTYPE_I64);

    auto result = AxpbyInfo::create(x_desc, y_desc);
    CHECK_RESULT(result);

    *desc_ptr = new Descriptor(
        result.take(),
        x_desc,
        0,
        new Opaque{handle->internal()},
        handle->device,
        handle->device_id);
    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    void *y,
    float alpha,
    float beta,
    void *stream) const {
    (void)workspace;
    if (workspace_size < _workspace_size) {
        return INFINI_STATUS_INSUFFICIENT_WORKSPACE;
    }
    if (_info.dtype != INFINI_DTYPE_F32) {
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }

    cnrtDim3_t dim = {16, 1, 1};
    cnrtFunctionType_t type = cnrtFuncTypeUnion1;
    axpbyScaleF32Kernel<<<dim, type, reinterpret_cast<cnrtQueue_t>(stream)>>>(
        utils::cast<int>(_info.n),
        utils::cast<int>(_info.incy),
        reinterpret_cast<float *>(y),
        beta);
    switch (_x_desc->indicesDesc()->dtype()) {
    case INFINI_DTYPE_I32:
        axpbyAddF32Kernel<int32_t><<<dim, type, reinterpret_cast<cnrtQueue_t>(stream)>>>(
            utils::cast<int>(_info.nnz),
            reinterpret_cast<const int32_t *>(_x_desc->indices()),
            reinterpret_cast<const float *>(_x_desc->values()),
            reinterpret_cast<float *>(y),
            utils::cast<int>(_info.incy),
            alpha);
        break;
    case INFINI_DTYPE_I64:
        axpbyAddF32Kernel<int64_t><<<dim, type, reinterpret_cast<cnrtQueue_t>(stream)>>>(
            utils::cast<int>(_info.nnz),
            reinterpret_cast<const int64_t *>(_x_desc->indices()),
            reinterpret_cast<const float *>(_x_desc->values()),
            reinterpret_cast<float *>(y),
            utils::cast<int>(_info.incy),
            alpha);
        break;
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
    cnrtQueueSync(reinterpret_cast<cnrtQueue_t>(stream));
    return INFINI_STATUS_SUCCESS;
}

} // namespace op::axpby::bang
