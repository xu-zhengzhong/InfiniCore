#include "../../../devices/metax/metax_ht2mc.h"
#include "spvv_metax.h"

namespace op::spvv::metax {

__global__ void applyAlphaBetaKernel(float *y, const float *dot, float alpha, float beta) {
    *y = alpha * (*dot) + beta * (*y);
}

infiniStatus_t launchApplyAlphaBeta(void *y, const void *dot, float alpha, float beta, void *stream) {
    applyAlphaBetaKernel<<<1, 1, 0, reinterpret_cast<hcStream_t>(stream)>>>(
        reinterpret_cast<float *>(y),
        reinterpret_cast<const float *>(dot),
        alpha,
        beta);
    auto err = hcGetLastError();
    if (err != hcSuccess) {
        return INFINI_STATUS_INTERNAL_ERROR;
    }
    return INFINI_STATUS_SUCCESS;
}

} // namespace op::spvv::metax
