#include "../../../devices/metax/metax_kernel_common.h"
#include "spvv_metax.h"

namespace op::spvv::metax {

template <typename Tindex>
__global__ void spvvKernel(
    float *y,
    const float *values,
    const Tindex *indices,
    const float *x,
    size_t nnz,
    float alpha,
    float beta) {
    __shared__ float shared[256];

    auto tid = threadIdx.x;
    float sum = 0.0f;
    for (size_t i = tid; i < nnz; i += blockDim.x) {
        sum += values[i] * x[indices[i]];
    }

    shared[tid] = sum;
    __syncthreads();

    for (unsigned int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            shared[tid] += shared[tid + stride];
        }
        __syncthreads();
    }

    if (tid == 0) {
        *y = alpha * shared[0] + beta * (*y);
    }
}

template <typename Tindex>
static infiniStatus_t launchCalculate(
    void *y,
    const void *values,
    const void *indices,
    const void *x,
    size_t nnz,
    float alpha,
    float beta,
    void *stream) {
    spvvKernel<Tindex><<<1, 256, 0, reinterpret_cast<hcStream_t>(stream)>>>(
        reinterpret_cast<float *>(y),
        reinterpret_cast<const float *>(values),
        reinterpret_cast<const Tindex *>(indices),
        reinterpret_cast<const float *>(x),
        nnz,
        alpha,
        beta);
    CHECK_METAX(hcGetLastError());
    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t launchCalculateI32(
    void *y,
    const void *values,
    const void *indices,
    const void *x,
    size_t nnz,
    float alpha,
    float beta,
    void *stream) {
    return launchCalculate<int32_t>(y, values, indices, x, nnz, alpha, beta, stream);
}

infiniStatus_t launchCalculateI64(
    void *y,
    const void *values,
    const void *indices,
    const void *x,
    size_t nnz,
    float alpha,
    float beta,
    void *stream) {
    return launchCalculate<int64_t>(y, values, indices, x, nnz, alpha, beta, stream);
}

} // namespace op::spvv::metax
