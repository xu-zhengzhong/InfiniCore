#include "../../../devices/bang/common_bang.h"
#include "blas_amin_bang.h"
#include "blas_amin_bang_kernel.mlu"

namespace op::blas_amin::bang {

Descriptor::~Descriptor() = default;

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopTensorDescriptor_t x_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto info = BlasAminInfo::createBlasAminInfo(x_desc);
    CHECK_RESULT(info);

    size_t workspace_size = sizeof(int);

    *desc_ptr = new Descriptor(
        info.take(),
        workspace_size,
        nullptr,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

template <typename Tdata>
infiniStatus_t calculateBlasAmin(
    const BlasAminInfo &info,
    const void *x,
    int *result,
    cnrtQueue_t queue,
    void *workspace,
    size_t workspace_size) {

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = 4;
    k_dim.y = 1;
    k_dim.z = 1;
    k_type = cnrtFuncTypeUnion1;

    int *d_result = (int *)workspace;

    if (info.getIncx() == 1) {
        blasAminKernelContiguous<Tdata><<<k_dim, k_type, queue>>>(
            info.getSize(),
            (const Tdata *)x,
            d_result);
    } else {
        blasAminKernelStrided<Tdata><<<k_dim, k_type, queue>>>(
            info.getSize(),
            (const Tdata *)x,
            info.getIncx(),
            d_result);
    }

    cnrtMemcpyAsync(result, d_result, workspace_size, queue, cnrtMemcpyDevToHost);
    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

#define CALCULATE_AMIN(TDATA)                          \
    calculateBlasAmin<TDATA>(                          \
        _info,                                         \
        x, result,                                     \
        (cnrtQueue_t)stream, workspace, workspace_size \
    )

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *x,
    int *result,
    void *stream) const {

    switch (_info.getDtype()) {
    case INFINI_DTYPE_F16:
        return CALCULATE_AMIN(half);
    case INFINI_DTYPE_BF16:
        return CALCULATE_AMIN(bfloat16_t);
    case INFINI_DTYPE_F32:
        return CALCULATE_AMIN(float);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

#undef CALCULATE_AMIN

} // namespace op::blas_amin::bang
