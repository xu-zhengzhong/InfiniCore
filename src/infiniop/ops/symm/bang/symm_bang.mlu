#include "../../../devices/bang/common_bang.h"
#include "../../gemm/info.h"
#include "symm_bang.h"

#include <algorithm>
#include <cnnl_extra.h>
#include <vector>

#define CHECK_BANGRT(API) CHECK_INTERNAL(API, cnrtSuccess)

template <typename Tdata>
__mlu_global__ void symmToDenseKernel(
    infiniopBlasFillMode_t uplo,
    int n,
    const Tdata *A,
    int A_row_stride,
    int A_col_stride,
    Tdata *dense_A) {

    const int total = n * n;
    for (int idx = taskId; idx < total; idx += taskDim) {
        const int row = idx / n;
        const int col = idx - row * n;
        const bool in_stored_triangle = uplo == INFINIOP_BLAS_FILL_MODE_UPPER ? row <= col : row >= col;
        const int src_row = in_stored_triangle ? row : col;
        const int src_col = in_stored_triangle ? col : row;
        dense_A[row * n + col] = A[src_row * A_row_stride + src_col * A_col_stride];
    }
}

namespace {

infiniStatus_t setMatrixTensorEx(
    cnnlTensorDescriptor_t desc,
    const op::gemm::BlasMatrix &matrix,
    infiniDtype_t dtype) {

    std::vector<int> dim_size = {
        static_cast<int>(matrix.rows),
        static_cast<int>(matrix.cols),
    };
    std::vector<int> dim_stride = {
        static_cast<int>(matrix.row_stride),
        static_cast<int>(matrix.col_stride),
    };
    CHECK_BANG(cnnlSetTensorDescriptorEx(
        desc,
        CNNL_LAYOUT_ARRAY,
        device::bang::getCnnlDtype(dtype),
        dim_size.size(),
        dim_size.data(),
        dim_stride.data()));
    return INFINI_STATUS_SUCCESS;
}

} // namespace

namespace op::symm::bang {

struct Descriptor::Opaque {
    cnnlMatMulDescriptor_t op;
    cnnlMatMulAlgo_t algo;
    cnnlMatMulHeuristicResult_t algo_result;
    cnnlTensorDescriptor_t a;
    cnnlTensorDescriptor_t b;
    cnnlTensorDescriptor_t c;
    op::gemm::MatmulInfo matmul_info;
    std::shared_ptr<device::bang::Handle::Internal> internal;
    size_t dense_a_workspace_size;
    size_t gemm_workspace_size;

    ~Opaque() {
        cnnlDestroyTensorDescriptor(a);
        cnnlDestroyTensorDescriptor(b);
        cnnlDestroyTensorDescriptor(c);
        cnnlDestroyMatMulDescriptor(op);
        cnnlDestroyMatMulAlgo(algo);
        cnnlDestroyMatMulHeuristicResult(algo_result);
    }
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopBlasSideMode_t side,
    infiniopBlasFillMode_t uplo,
    infiniopTensorDescriptor_t alpha_desc,
    infiniopTensorDescriptor_t A_desc,
    infiniopTensorDescriptor_t B_desc,
    infiniopTensorDescriptor_t beta_desc,
    infiniopTensorDescriptor_t C_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = SymmInfo::createSymmInfo(side, uplo, alpha_desc, A_desc, B_desc, beta_desc, C_desc);
    CHECK_RESULT(result);
    auto info = result.take();

    CHECK_DTYPE(info.data_type, INFINI_DTYPE_F32);

    const size_t dense_a_dim = side == INFINIOP_BLAS_SIDE_LEFT ? info.m : info.n;
    const size_t dense_a_shape[] = {dense_a_dim, dense_a_dim};
    const ptrdiff_t dense_a_strides[] = {
        static_cast<ptrdiff_t>(dense_a_dim),
        1,
    };
    InfiniopTensorDescriptor dense_a_desc(
        info.data_type,
        2,
        dense_a_shape,
        dense_a_strides);

    auto matmul_result = side == INFINIOP_BLAS_SIDE_LEFT
                           ? op::gemm::MatmulInfo::create(C_desc, &dense_a_desc, B_desc, op::gemm::MatrixLayout::ROW_MAJOR)
                           : op::gemm::MatmulInfo::create(C_desc, B_desc, &dense_a_desc, op::gemm::MatrixLayout::ROW_MAJOR);
    CHECK_RESULT(matmul_result);
    auto matmul_info = matmul_result.take();

    cnnlTensorDescriptor_t a;
    cnnlTensorDescriptor_t b;
    cnnlTensorDescriptor_t c;
    CHECK_BANG(cnnlCreateTensorDescriptor(&a));
    CHECK_BANG(cnnlCreateTensorDescriptor(&b));
    CHECK_BANG(cnnlCreateTensorDescriptor(&c));

    CHECK_STATUS(setMatrixTensorEx(a, matmul_info.a_matrix, info.data_type));
    CHECK_STATUS(setMatrixTensorEx(b, matmul_info.b_matrix, info.data_type));
    CHECK_STATUS(setMatrixTensorEx(c, matmul_info.c_matrix, info.data_type));

    cnnlMatMulDescriptor_t op;
    cnnlMatMulAlgo_t algo;
    cnnlMatMulHeuristicResult_t algo_result;
    CHECK_BANG(cnnlCreateMatMulDescriptor(&op));
    CHECK_BANG(cnnlCreateMatMulAlgo(&algo));
    CHECK_BANG(cnnlCreateMatMulHeuristicResult(&algo_result));

    int32_t use_stride = true;
    CHECK_BANG(cnnlSetMatMulDescAttr(
        op,
        CNNL_MATMUL_USE_STRIDE,
        &use_stride,
        sizeof(int32_t)));

    int count = 0;
    CHECK_STATUS(
        handle->internal()->useCnnl(
            (cnrtQueue_t) nullptr,
            [&](cnnlHandle_t cnnl_handle) {
                CHECK_BANG(cnnlGetBatchMatMulExAlgoHeuristic(
                    cnnl_handle,
                    op,
                    a,
                    b,
                    c,
                    nullptr,
                    1,
                    &algo_result,
                    &count));
                return INFINI_STATUS_SUCCESS;
            }));

    size_t gemm_workspace_size = 0;
    CHECK_BANG(cnnlGetBatchMatMulExHeuristicResult(algo_result, algo, &gemm_workspace_size));

    const size_t dense_a_workspace_size = utils::align(dense_a_dim * dense_a_dim * infiniSizeOf(info.data_type), ALIGN_SIZE);
    const size_t workspace_size = dense_a_workspace_size + gemm_workspace_size;

    *desc_ptr = new Descriptor(
        info,
        workspace_size,
        new Descriptor::Opaque{
            op,
            algo,
            algo_result,
            a,
            b,
            c,
            matmul_info,
            handle->internal(),
            dense_a_workspace_size,
            gemm_workspace_size},
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *alpha,
    const void *A,
    const void *B,
    const void *beta,
    void *C,
    void *stream) const {

    int core_per_cluster = _opaque->internal->getCorePerCluster();
    int cluster_count = _opaque->internal->getClusterCount();

    if (_info.data_type != INFINI_DTYPE_F32) {
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }

    const size_t required_workspace = _opaque->dense_a_workspace_size + _opaque->gemm_workspace_size;
    CHECK_OR_RETURN(workspace_size >= required_workspace, INFINI_STATUS_INSUFFICIENT_WORKSPACE);
    CHECK_OR_RETURN(workspace != nullptr || required_workspace == 0, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(alpha != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(A != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(B != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(beta != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(C != nullptr, INFINI_STATUS_NULL_POINTER);

    float alpha_value = 0;
    float beta_value = 0;
    CHECK_BANGRT(cnrtMemcpy(&alpha_value, (void *)alpha, sizeof(float), cnrtMemcpyDevToHost));
    CHECK_BANGRT(cnrtMemcpy(&beta_value, (void *)beta, sizeof(float), cnrtMemcpyDevToHost));

    const int dense_a_dim = utils::cast<int>(_info.side == INFINIOP_BLAS_SIDE_LEFT ? _info.m : _info.n);

    cnrtDim3_t k_dim;
    k_dim.x = core_per_cluster;
    k_dim.y = cluster_count;
    k_dim.z = 1;
    const cnrtFunctionType_t k_type = cnrtFuncTypeUnion1;

    auto dense_A = reinterpret_cast<float *>(workspace);
    symmToDenseKernel<float><<<k_dim, k_type, (cnrtQueue_t)stream>>>(
        _info.uplo,
        dense_a_dim,
        (const float *)A,
        utils::cast<int>(_info.A_row_stride),
        utils::cast<int>(_info.A_col_stride),
        dense_A);

    const void *gemm_a = nullptr;
    const void *gemm_b = nullptr;
    if (_info.side == INFINIOP_BLAS_SIDE_LEFT) {
        gemm_a = dense_A;
        gemm_b = B;
    } else {
        gemm_a = B;
        gemm_b = dense_A;
    }
    if (_opaque->matmul_info.is_transed) {
        std::swap(gemm_a, gemm_b);
    }

    void *gemm_workspace = reinterpret_cast<char *>(workspace) + _opaque->dense_a_workspace_size;
    const size_t available_gemm_workspace = workspace_size - _opaque->dense_a_workspace_size;

    CHECK_STATUS(_opaque->internal->useCnnl(
        (cnrtQueue_t)stream,
        [&](cnnlHandle_t cnnl_handle) {
            CHECK_BANG(cnnlBatchMatMulEx(
                cnnl_handle,
                _opaque->op,
                _opaque->algo,
                &alpha_value,
                _opaque->a,
                gemm_a,
                _opaque->b,
                gemm_b,
                &beta_value,
                _opaque->c,
                C,
                gemm_workspace,
                available_gemm_workspace));
            return INFINI_STATUS_SUCCESS;
        }));
    CHECK_BANGRT(cnrtQueueSync((cnrtQueue_t)stream));

    return INFINI_STATUS_SUCCESS;
}

#undef CHECK_BANGRT

} // namespace op::symm::bang
