#include "../../../devices/bang/common_bang.h"
#include "hpr2_bang.h"
#include "hpr2_bang_kernel.mlu"

namespace op::hpr2::bang {

Descriptor::~Descriptor() = default;

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopBlasFillMode_t uplo,
    infiniopTensorDescriptor_t alpha_desc,
    infiniopTensorDescriptor_t x_desc,
    infiniopTensorDescriptor_t y_desc,
    infiniopTensorDescriptor_t AP_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = Hpr2Info::createHpr2Info(uplo, alpha_desc, x_desc, y_desc, AP_desc);
    CHECK_RESULT(result);

    *desc_ptr = new Descriptor(
        result.take(),
        0,
        nullptr,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t calculateHpr2(
    const Hpr2Info &info,
    const device::bang::FloatComplex *alpha,
    const device::bang::FloatComplex *x,
    const device::bang::FloatComplex *y,
    device::bang::FloatComplex *AP,
    cnrtQueue_t queue) {

    const int n = utils::cast<int>(info.n);
    const int incx = utils::cast<int>(info.incx);
    const int incy = utils::cast<int>(info.incy);

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = 4;
    k_dim.y = 1;
    k_dim.z = 1;
    k_type = cnrtFuncTypeUnion1;

    hpr2Kernel<<<k_dim, k_type, queue>>>(
        info.uplo,
        n,
        alpha,
        x, incx,
        y, incy,
        AP);

    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

#define CALCULATE_HPR2(TDATA)           \
    calculateHpr2(_info,                \
                  (const TDATA *)alpha, \
                  (const TDATA *)x,     \
                  (const TDATA *)y,     \
                  (TDATA *)AP,          \
                  (cnrtQueue_t)stream)

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *alpha,
    const void *x,
    const void *y,
    void *AP,
    void *stream) const {

    (void)workspace;
    (void)workspace_size;

    switch (_info.data_type) {
    case INFINI_DTYPE_C64:
        return CALCULATE_HPR2(device::bang::FloatComplex);
    case INFINI_DTYPE_C128:
        return INFINI_STATUS_DEVICE_TYPE_NOT_SUPPORTED;
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

#undef CALCULATE_HPR2

} // namespace op::hpr2::bang
