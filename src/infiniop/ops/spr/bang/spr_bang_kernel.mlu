#include "../../../devices/bang/common_bang.h"
#include "spr_bang.h"

__nram__ char nram_buffer[NRAM_MAX_SIZE];

template <typename Tdata, bool CONTIGUOUS>
__mlu_device__ void sprKernelImpl(
    bool upper,
    int n,
    const Tdata *alpha,
    const Tdata *x, int incx,
    Tdata *AP) {

    char *nram_aligned = (char *)(((size_t)nram_buffer + ALIGN_SIZE - 1) & ~(ALIGN_SIZE - 1));

    size_t nram_usable = NRAM_MAX_SIZE - (nram_aligned - nram_buffer);
    size_t max_chunk_elements = nram_usable / (2 * sizeof(Tdata));

    size_t align_elements = ALIGN_SIZE / sizeof(Tdata);
    if (align_elements == 0) {
        align_elements = 1;
    }
    int chunk_size = (int)((max_chunk_elements / align_elements) * align_elements);

    Tdata *nram_AP = (Tdata *)nram_aligned;
    Tdata *nram_x = nram_AP + chunk_size;

    int elements_per_core = n / taskDim;
    int remain = n % taskDim;
    int core_elements = elements_per_core + (taskId < remain ? 1 : 0);
    int core_offset = taskId < remain ? taskId * core_elements : taskId * elements_per_core + remain;

    if (core_elements <= 0 || (*alpha) == (Tdata)0) {
        return;
    }

    for (int j = core_offset; j < core_offset + core_elements; j++) {
        Tdata xj = x[j * incx];
        if (xj == (Tdata)0) {
            continue;
        }

        Tdata temp = (*alpha) * xj;
        int start = upper ? 0 : j;
        int elements = upper ? j + 1 : n - j;
        int AP_offset = upper ? j * (j + 1) / 2 : j * n - j * (j - 1) / 2;
        int chunks = elements / chunk_size;
        int chunk_rem = elements % chunk_size;

        for (int c = 0; c < chunks; c++) {
            int current_offset = start + c * chunk_size;
            int packed_offset = AP_offset + c * chunk_size;

            __memcpy(nram_AP, AP + packed_offset, chunk_size * sizeof(Tdata), GDRAM2NRAM);
            if constexpr (CONTIGUOUS) {
                __memcpy(nram_x, x + current_offset, chunk_size * sizeof(Tdata), GDRAM2NRAM);
            } else {
                for (int i = 0; i < chunk_size; i++) {
                    nram_x[i] = x[(current_offset + i) * incx];
                }
            }

            __bang_mul_scalar(nram_x, nram_x, temp, chunk_size);
            __bang_add(nram_AP, nram_AP, nram_x, chunk_size);

            __memcpy(AP + packed_offset, nram_AP, chunk_size * sizeof(Tdata), NRAM2GDRAM);
        }

        if (chunk_rem > 0) {
            int current_offset = start + chunks * chunk_size;
            int packed_offset = AP_offset + chunks * chunk_size;
            int align_rem = ((chunk_rem + align_elements - 1) / align_elements) * align_elements;

            __memcpy(nram_AP, AP + packed_offset, chunk_rem * sizeof(Tdata), GDRAM2NRAM);
            if constexpr (CONTIGUOUS) {
                __memcpy(nram_x, x + current_offset, chunk_rem * sizeof(Tdata), GDRAM2NRAM);
            } else {
                for (int i = 0; i < chunk_rem; i++) {
                    nram_x[i] = x[(current_offset + i) * incx];
                }
            }

            __bang_mul_scalar(nram_x, nram_x, temp, align_rem);
            __bang_add(nram_AP, nram_AP, nram_x, align_rem);

            __memcpy(AP + packed_offset, nram_AP, chunk_rem * sizeof(Tdata), NRAM2GDRAM);
        }
    }
}

#define DISPATCH_SPR(CONTIG) \
    sprKernelImpl<Tdata, CONTIG>(upper, n, alpha, x, incx, AP)

template <typename Tdata>
__mlu_global__ void sprKernel(
    infiniopBlasFillMode_t uplo,
    int n,
    const Tdata *alpha,
    const Tdata *x, int incx,
    Tdata *AP) {

    const bool upper = uplo == INFINIOP_BLAS_FILL_MODE_UPPER;
    const bool x_contiguous = incx == 1;

    if (x_contiguous) {
        DISPATCH_SPR(true);
    } else {
        DISPATCH_SPR(false);
    }

#undef DISPATCH_SPR
}
