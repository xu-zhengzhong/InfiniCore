#include "../../blas_cnnl_bang.h"
#include "scal_bang.h"

namespace op::scal::bang {

namespace {

bool isSupported(infiniDtype_t dtype) {
    return dtype == INFINI_DTYPE_F16
        || dtype == INFINI_DTYPE_BF16
        || dtype == INFINI_DTYPE_F32;
}

} // namespace

struct Descriptor::Opaque {
    blas_cnnl::bang::TensorDescriptor x;
    blas_cnnl::bang::TensorDescriptor alpha;
    blas_cnnl::bang::TensorDescriptor temp;
    blas_cnnl::bang::OpTensorDescriptor mul;
    std::shared_ptr<device::bang::Handle::Internal> internal;
    size_t temp_workspace_size = 0;
    size_t mul_workspace_size = 0;
    size_t copy_workspace_size = 0;
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopTensorDescriptor_t alpha_desc,
    infiniopTensorDescriptor_t x_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = ScalInfo::createScalInfo(alpha_desc, x_desc);
    CHECK_RESULT(result);
    auto info = result.take();

    if (!isSupported(info.data_type)) {
        *desc_ptr = new Descriptor(
            info,
            0,
            nullptr,
            handle->device,
            handle->device_id);
        return INFINI_STATUS_SUCCESS;
    }

    auto opaque = new Opaque{};
    opaque->internal = handle->internal();
    opaque->temp_workspace_size = blas_cnnl::bang::vectorBytes(info.n, info.data_type);

    CHECK_STATUS(blas_cnnl::bang::setVectorTensor(opaque->x, info.n, info.incx, info.data_type));
    CHECK_STATUS(blas_cnnl::bang::setScalarTensor(opaque->alpha, info.data_type));
    CHECK_STATUS(blas_cnnl::bang::setContiguousVectorTensor(opaque->temp, info.n, info.data_type));
    CHECK_STATUS(opaque->mul.create(CNNL_OP_TENSOR_MUL));
    CHECK_STATUS(blas_cnnl::bang::getOpTensorWorkspaceSize(
        opaque->internal,
        opaque->x,
        opaque->alpha,
        opaque->temp,
        &opaque->mul_workspace_size));
    CHECK_STATUS(blas_cnnl::bang::getCopyWorkspaceSize(
        opaque->internal,
        opaque->temp,
        opaque->x,
        &opaque->copy_workspace_size));

    const size_t workspace_size = opaque->temp_workspace_size
                                + std::max(opaque->mul_workspace_size, opaque->copy_workspace_size);

    *desc_ptr = new Descriptor(
        info,
        workspace_size,
        opaque,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *alpha,
    void *x,
    void *stream) const {

    if (!isSupported(_info.data_type)) {
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }

    CHECK_OR_RETURN(_opaque != nullptr, INFINI_STATUS_INTERNAL_ERROR);
    CHECK_OR_RETURN(workspace_size >= workspaceSize(), INFINI_STATUS_INSUFFICIENT_WORKSPACE);
    CHECK_OR_RETURN(workspace != nullptr || workspaceSize() == 0, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(alpha != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(x != nullptr, INFINI_STATUS_NULL_POINTER);

    void *temp = workspace;
    void *op_workspace = blas_cnnl::bang::workspaceAt(workspace, _opaque->temp_workspace_size);
    const size_t op_workspace_size = workspace_size - _opaque->temp_workspace_size;
    void *x_ptr = blas_cnnl::bang::logicalVectorPtr(x, _info.n, _info.incx, _info.data_type);

    CHECK_STATUS(blas_cnnl::bang::cnnlOpTensor(
        _opaque->internal,
        (cnrtQueue_t)stream,
        _opaque->mul,
        1.0f,
        _opaque->x,
        x_ptr,
        1.0f,
        _opaque->alpha,
        alpha,
        op_workspace,
        op_workspace_size,
        0.0f,
        _opaque->temp,
        temp));
    CHECK_STATUS(blas_cnnl::bang::cnnlCopy(
        _opaque->internal,
        (cnrtQueue_t)stream,
        _opaque->temp,
        temp,
        _opaque->x,
        x_ptr,
        op_workspace,
        op_workspace_size));
    CHECK_STATUS(blas_cnnl::bang::syncQueue((cnrtQueue_t)stream));

    return INFINI_STATUS_SUCCESS;
}

} // namespace op::scal::bang
