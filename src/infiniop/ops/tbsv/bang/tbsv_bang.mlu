#include "../../../devices/bang/common_bang.h"
#include "tbsv_bang.h"
#include "tbsv_bang_kernel.mlu"

namespace op::tbsv::bang {

Descriptor::~Descriptor() = default;

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopBlasFillMode_t uplo,
    infiniopBlasOperation_t trans,
    infiniopBlasDiagType_t diag,
    size_t k,
    infiniopTensorDescriptor_t A_desc,
    infiniopTensorDescriptor_t x_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = TbsvInfo::createTbsvInfo(uplo, trans, diag, k, A_desc, x_desc);
    CHECK_RESULT(result);

    *desc_ptr = new Descriptor(
        result.take(),
        0,
        nullptr,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

template <typename Tdata>
infiniStatus_t calculateTbsv(
    const TbsvInfo &info,
    const Tdata *A,
    Tdata *x,
    cnrtQueue_t queue) {

    const int n = utils::cast<int>(info.n);
    const int k = utils::cast<int>(info.k);
    const int incx = utils::cast<int>(info.incx);
    const int lda = utils::cast<int>(info.A_col_stride);

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = 1;
    k_dim.y = 1;
    k_dim.z = 1;
    k_type = cnrtFuncTypeBlock;

    tbsvKernel<Tdata><<<k_dim, k_type, queue>>>(
        info.uplo,
        info.trans,
        info.diag,
        n, k,
        A, lda,
        x, incx);

    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

#define CALCULATE_TBSV(TDATA)       \
    calculateTbsv(_info,            \
                  (const TDATA *)A, \
                  (TDATA *)x,       \
                  (cnrtQueue_t)stream)

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *A,
    void *x,
    void *stream) const {

    (void)workspace;
    (void)workspace_size;

    switch (_info.data_type) {
    case INFINI_DTYPE_F32:
        return CALCULATE_TBSV(float);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

#undef CALCULATE_TBSV

} // namespace op::tbsv::bang
