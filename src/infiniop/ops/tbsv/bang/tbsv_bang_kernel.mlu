#include "../../../devices/bang/common_bang.h"
#include "tbsv_bang.h"

template <typename Tdata, bool UPPER, bool TRANS, bool UNIT_DIAG>
__mlu_func__ void tbsvKernelImpl(
    int n, int k,
    const Tdata *A, int lda,
    Tdata *x, int incx) {

    if (n <= 0 || taskId != 0) {
        return;
    }

    if constexpr (!TRANS) {
        if constexpr (UPPER) {
            for (int j = n - 1; j >= 0; --j) {
                Tdata value = x[j * incx];
                if constexpr (!UNIT_DIAG) {
                    value /= A[k + j * lda];
                    x[j * incx] = value;
                }
                int i_begin = j > k ? j - k : 0;
                for (int i = j - 1; i >= i_begin; --i) {
                    x[i * incx] -= value * A[k + i - j + j * lda];
                }
            }
        } else {
            for (int j = 0; j < n; ++j) {
                Tdata value = x[j * incx];
                if constexpr (!UNIT_DIAG) {
                    value /= A[j * lda];
                    x[j * incx] = value;
                }
                int i_end = j + k + 1 < n ? j + k + 1 : n;
                for (int i = j + 1; i < i_end; ++i) {
                    x[i * incx] -= value * A[i - j + j * lda];
                }
            }
        }
    } else {
        if constexpr (UPPER) {
            for (int j = 0; j < n; ++j) {
                Tdata value = x[j * incx];
                int i_begin = j > k ? j - k : 0;
                for (int i = i_begin; i < j; ++i) {
                    value -= A[k + i - j + j * lda] * x[i * incx];
                }
                if constexpr (!UNIT_DIAG) {
                    value /= A[k + j * lda];
                }
                x[j * incx] = value;
            }
        } else {
            for (int j = n - 1; j >= 0; --j) {
                Tdata value = x[j * incx];
                int i_end = j + k + 1 < n ? j + k + 1 : n;
                for (int i = i_end - 1; i > j; --i) {
                    value -= A[i - j + j * lda] * x[i * incx];
                }
                if constexpr (!UNIT_DIAG) {
                    value /= A[j * lda];
                }
                x[j * incx] = value;
            }
        }
    }
}

#define DISPATCH_TBSV(UPPER, TRANS, UNIT) \
    tbsvKernelImpl<Tdata, UPPER, TRANS, UNIT>(n, k, A, lda, x, incx)

template <typename Tdata>
__mlu_global__ void tbsvKernel(
    infiniopBlasFillMode_t uplo,
    infiniopBlasOperation_t trans,
    infiniopBlasDiagType_t diag,
    int n, int k,
    const Tdata *A, int lda,
    Tdata *x, int incx) {

    const bool upper = uplo == INFINIOP_BLAS_FILL_MODE_UPPER;
    const bool transposed = trans == INFINIOP_BLAS_OP_T;
    const bool unit_diag = diag == INFINIOP_BLAS_DIAG_UNIT;

    if (transposed) {
        if (unit_diag) {
            if (upper) {
                DISPATCH_TBSV(true, true, true);
            } else {
                DISPATCH_TBSV(false, true, true);
            }
        } else {
            if (upper) {
                DISPATCH_TBSV(true, true, false);
            } else {
                DISPATCH_TBSV(false, true, false);
            }
        }
    } else {
        if (unit_diag) {
            if (upper) {
                DISPATCH_TBSV(true, false, true);
            } else {
                DISPATCH_TBSV(false, false, true);
            }
        } else {
            if (upper) {
                DISPATCH_TBSV(true, false, false);
            } else {
                DISPATCH_TBSV(false, false, false);
            }
        }
    }

#undef DISPATCH_TBSV
}
