#include "../../../devices/bang/common_bang.h"
#include "dot_bang.h"

template <typename Tdata>
__mlu_global__ void dotKernelContiguous(
    size_t n,
    const Tdata *x,
    const Tdata *y,
    Tdata *result) {
    __mlu_shared__ Tdata shared_partial_sum[4];

    size_t elements_per_core = n / taskDim;
    size_t remain = n % taskDim;
    size_t core_elements = elements_per_core + (taskId < remain ? 1 : 0);
    size_t core_offset = taskId < remain ? taskId * core_elements : taskId * elements_per_core + remain;

    Tdata partial_sum = static_cast<Tdata>(0);

    for (size_t i = core_offset; i < core_offset + core_elements; ++i) {
        partial_sum += x[i] * y[i];
    }

    shared_partial_sum[coreId] = partial_sum;

    __sync_cluster();

    if (coreId == 0) {
        Tdata cluster_sum = static_cast<Tdata>(0);
        for (int i = 0; i < coreDim; ++i) {
            cluster_sum += shared_partial_sum[i];
        }
        result[0] = cluster_sum;
    }
}

template <typename Tdata>
__mlu_global__ void dotKernelStrided(
    size_t n,
    const Tdata *x,
    ptrdiff_t incx,
    const Tdata *y,
    ptrdiff_t incy,
    Tdata *result) {
    __mlu_shared__ Tdata shared_partial_sum[4];

    size_t elements_per_core = n / taskDim;
    size_t remain = n % taskDim;
    size_t core_elements = elements_per_core + (taskId < remain ? 1 : 0);
    size_t start_idx = taskId < remain ? taskId * core_elements : taskId * elements_per_core + remain;

    Tdata partial_sum = static_cast<Tdata>(0);
    ptrdiff_t x_offset = static_cast<ptrdiff_t>(start_idx) * incx;
    ptrdiff_t y_offset = static_cast<ptrdiff_t>(start_idx) * incy;

    for (size_t i = 0; i < core_elements; ++i) {
        partial_sum += x[x_offset] * y[y_offset];
        x_offset += incx;
        y_offset += incy;
    }

    shared_partial_sum[coreId] = partial_sum;

    __sync_cluster();

    if (coreId == 0) {
        Tdata cluster_sum = static_cast<Tdata>(0);
        for (int i = 0; i < coreDim; ++i) {
            cluster_sum += shared_partial_sum[i];
        }
        result[0] = cluster_sum;
    }
}