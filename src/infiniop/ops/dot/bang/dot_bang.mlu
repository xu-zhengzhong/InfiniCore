#include "../../../devices/bang/common_bang.h"
#include "dot_bang.h"
#include "dot_bang_kernel.mlu"

namespace op::dot::bang {

Descriptor::~Descriptor() = default;

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopTensorDescriptor_t x_desc,
    infiniopTensorDescriptor_t y_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto info = DotInfo::createDotInfo(x_desc, y_desc);
    CHECK_RESULT(info);

    size_t workspace_size = infiniSizeOf(x_desc->dtype());

    *desc_ptr = new Descriptor(
        info.take(),
        workspace_size,
        nullptr,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

template <typename Tdata>
infiniStatus_t calculateDot(
    const DotInfo &info,
    const void *x,
    const void *y,
    void *result,
    cnrtQueue_t queue,
    void *workspace,
    size_t workspace_size) {

    if (info.getSize() == 0) {
        reinterpret_cast<Tdata *>(result)[0] = static_cast<Tdata>(0);
        return INFINI_STATUS_SUCCESS;
    }

    if (workspace == nullptr || workspace_size < sizeof(Tdata)) {
        return INFINI_STATUS_INSUFFICIENT_WORKSPACE;
    }

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = 4;
    k_dim.y = 1;
    k_dim.z = 1;
    k_type = cnrtFuncTypeUnion1;

    Tdata *d_result = reinterpret_cast<Tdata *>(workspace);

    if (info.getIncx() == 1 && info.getIncy() == 1) {
        dotKernelContiguous<Tdata><<<k_dim, k_type, queue>>>(
            info.getSize(),
            reinterpret_cast<const Tdata *>(x),
            reinterpret_cast<const Tdata *>(y),
            d_result);
    } else {
        dotKernelStrided<Tdata><<<k_dim, k_type, queue>>>(
            info.getSize(),
            reinterpret_cast<const Tdata *>(x),
            info.getIncx(),
            reinterpret_cast<const Tdata *>(y),
            info.getIncy(),
            d_result);
    }

    cnrtMemcpyAsync(result, d_result, sizeof(Tdata), queue, cnrtMemcpyDevToHost);
    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *x,
    const void *y,
    void *result,
    void *stream) const {

#define CALCULATE_DOT(TDATA) \
    calculateDot<TDATA>(     \
        _info,               \
        x,                   \
        y,                   \
        result,              \
        (cnrtQueue_t)stream, \
        workspace,           \
        workspace_size)

    switch (_info.getDtype()) {
    case INFINI_DTYPE_F32:
        return CALCULATE_DOT(float);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }

#undef CALCULATE_DOT
}

} // namespace op::dot::bang