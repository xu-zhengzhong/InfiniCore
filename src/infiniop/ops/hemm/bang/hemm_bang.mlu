#include "../../../devices/bang/common_bang.h"
#include "hemm_bang.h"
#include "hemm_bang_kernel.mlu"

#include <algorithm>
#include <cstdlib>

namespace {

struct HemmTileConfig {
    int rows;
    int cols;
};

bool betterEnoughTile(
    int rows,
    int cols,
    int m,
    int n,
    int tile_count,
    const HemmTileConfig &best) {

    const int effective_area = std::min(rows, m) * std::min(cols, n);
    const int best_effective_area = std::min(best.rows, m) * std::min(best.cols, n);
    if (effective_area != best_effective_area) {
        return effective_area > best_effective_area;
    }

    const int waste = rows * cols - effective_area;
    const int best_waste = best.rows * best.cols - best_effective_area;
    if (waste != best_waste) {
        return waste < best_waste;
    }

    const int aspect_delta = std::abs(rows * n - cols * m);
    const int best_aspect_delta = std::abs(best.rows * n - best.cols * m);
    if (aspect_delta != best_aspect_delta) {
        return aspect_delta < best_aspect_delta;
    }

    const int best_tile_count = CEIL_DIV(m, best.rows) * CEIL_DIV(n, best.cols);
    return tile_count < best_tile_count;
}

bool betterParallelTile(
    int rows,
    int cols,
    int m,
    int n,
    int tile_count,
    const HemmTileConfig &best) {

    const int best_tile_count = CEIL_DIV(m, best.rows) * CEIL_DIV(n, best.cols);
    if (tile_count != best_tile_count) {
        return tile_count > best_tile_count;
    }

    const int effective_area = std::min(rows, m) * std::min(cols, n);
    const int best_effective_area = std::min(best.rows, m) * std::min(best.cols, n);
    if (effective_area != best_effective_area) {
        return effective_area > best_effective_area;
    }

    const int waste = rows * cols - effective_area;
    const int best_waste = best.rows * best.cols - best_effective_area;
    return waste < best_waste;
}

HemmTileConfig chooseHemmTile(int m, int n, int task_count) {
    const HemmTileConfig candidates[] = {
        {4, 4},
        {4, 8},
        {8, 4},
        {8, 8},
        {8, 16},
        {16, 8},
        {16, 16},
        {16, 32},
        {32, 16},
        {32, 32},
        {32, 64},
        {64, 32},
        {64, 64},
    };
    const int candidate_count = sizeof(candidates) / sizeof(candidates[0]);
    const int target_tiles = task_count > 0 ? task_count : 1;

    HemmTileConfig best = candidates[0];
    bool has_enough_tiles = false;

    for (int candidate_idx = 0; candidate_idx < candidate_count; ++candidate_idx) {
        const int rows = candidates[candidate_idx].rows;
        const int cols = candidates[candidate_idx].cols;
        const int tile_count = CEIL_DIV(m, rows) * CEIL_DIV(n, cols);
        const bool enough_tiles = tile_count >= target_tiles;

        if (enough_tiles) {
            if (!has_enough_tiles || betterEnoughTile(rows, cols, m, n, tile_count, best)) {
                best = candidates[candidate_idx];
            }
            has_enough_tiles = true;
        } else if (!has_enough_tiles && betterParallelTile(rows, cols, m, n, tile_count, best)) {
            best = candidates[candidate_idx];
        }
    }

    return best;
}

void dispatchHemmKernel(
    int task_count,
    cnrtDim3_t k_dim,
    cnrtFunctionType_t k_type,
    cnrtQueue_t queue,
    infiniopBlasSideMode_t side,
    infiniopBlasFillMode_t uplo,
    int m,
    int n,
    const device::bang::FloatComplex *alpha,
    const device::bang::FloatComplex *A,
    int lda,
    const device::bang::FloatComplex *B,
    int ldb,
    const device::bang::FloatComplex *beta,
    device::bang::FloatComplex *C,
    int ldc) {

    const HemmTileConfig tile = chooseHemmTile(m, n, task_count);

#define LAUNCH_HEMM_TILE(TILE_ROWS, TILE_COLS) \
    hemmKernel<TILE_ROWS, TILE_COLS><<<k_dim, k_type, queue>>>(side, uplo, m, n, alpha, A, lda, B, ldb, beta, C, ldc)

#define DISPATCH_HEMM_ROW_4()   \
    switch (tile.cols) {        \
    case 4:                     \
        LAUNCH_HEMM_TILE(4, 4); \
        break;                  \
    case 8:                     \
    default:                    \
        LAUNCH_HEMM_TILE(4, 8); \
        break;                  \
    }

#define DISPATCH_HEMM_ROW_8()    \
    switch (tile.cols) {         \
    case 4:                      \
        LAUNCH_HEMM_TILE(8, 4);  \
        break;                   \
    case 8:                      \
        LAUNCH_HEMM_TILE(8, 8);  \
        break;                   \
    case 16:                     \
    default:                     \
        LAUNCH_HEMM_TILE(8, 16); \
        break;                   \
    }

#define DISPATCH_HEMM_ROW_16()    \
    switch (tile.cols) {          \
    case 8:                       \
        LAUNCH_HEMM_TILE(16, 8);  \
        break;                    \
    case 16:                      \
        LAUNCH_HEMM_TILE(16, 16); \
        break;                    \
    case 32:                      \
    default:                      \
        LAUNCH_HEMM_TILE(16, 32); \
        break;                    \
    }

#define DISPATCH_HEMM_ROW_32()    \
    switch (tile.cols) {          \
    case 16:                      \
        LAUNCH_HEMM_TILE(32, 16); \
        break;                    \
    case 32:                      \
        LAUNCH_HEMM_TILE(32, 32); \
        break;                    \
    case 64:                      \
    default:                      \
        LAUNCH_HEMM_TILE(32, 64); \
        break;                    \
    }

#define DISPATCH_HEMM_ROW_64()    \
    switch (tile.cols) {          \
    case 32:                      \
        LAUNCH_HEMM_TILE(64, 32); \
        break;                    \
    case 64:                      \
    default:                      \
        LAUNCH_HEMM_TILE(64, 64); \
        break;                    \
    }

    switch (tile.rows) {
    case 4:
        DISPATCH_HEMM_ROW_4();
        break;
    case 8:
        DISPATCH_HEMM_ROW_8();
        break;
    case 16:
        DISPATCH_HEMM_ROW_16();
        break;
    case 32:
        DISPATCH_HEMM_ROW_32();
        break;
    case 64:
        DISPATCH_HEMM_ROW_64();
        break;
    default:
        DISPATCH_HEMM_ROW_32();
        break;
    }

#undef DISPATCH_HEMM_ROW_64
#undef DISPATCH_HEMM_ROW_32
#undef DISPATCH_HEMM_ROW_16
#undef DISPATCH_HEMM_ROW_8
#undef DISPATCH_HEMM_ROW_4
#undef LAUNCH_HEMM_TILE
}

} // namespace

namespace op::hemm::bang {

struct Descriptor::Opaque {
    std::shared_ptr<device::bang::Handle::Internal> internal;
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopBlasSideMode_t side,
    infiniopBlasFillMode_t uplo,
    infiniopTensorDescriptor_t alpha_desc,
    infiniopTensorDescriptor_t A_desc,
    infiniopTensorDescriptor_t B_desc,
    infiniopTensorDescriptor_t beta_desc,
    infiniopTensorDescriptor_t C_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = HemmInfo::createHemmInfo(side, uplo, alpha_desc, A_desc, B_desc, beta_desc, C_desc);
    CHECK_RESULT(result);

    *desc_ptr = new Descriptor(
        result.take(),
        0,
        new Descriptor::Opaque{handle->internal()},
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t calculateHemm(
    const HemmInfo &info,
    const device::bang::FloatComplex *alpha,
    const device::bang::FloatComplex *A,
    const device::bang::FloatComplex *B,
    const device::bang::FloatComplex *beta,
    device::bang::FloatComplex *C,
    int core_per_cluster,
    int cluster_count,
    cnrtQueue_t queue) {

    const int m = utils::cast<int>(info.m);
    const int n = utils::cast<int>(info.n);
    const int lda = utils::cast<int>(info.A_col_stride);
    const int ldb = utils::cast<int>(info.B_col_stride);
    const int ldc = utils::cast<int>(info.C_col_stride);

    cnrtDim3_t k_dim;
    cnrtFunctionType_t k_type;

    k_dim.x = core_per_cluster;
    k_dim.y = cluster_count;
    k_dim.z = 1;
    k_type = cnrtFuncTypeUnion1;

    dispatchHemmKernel(
        core_per_cluster * cluster_count,
        k_dim,
        k_type,
        queue,
        info.side,
        info.uplo,
        m,
        n,
        alpha,
        A,
        lda,
        B,
        ldb,
        beta,
        C,
        ldc);

    cnrtQueueSync(queue);

    return INFINI_STATUS_SUCCESS;
}

#define CALCULATE_HEMM(TDATA)           \
    calculateHemm(_info,                \
                  (const TDATA *)alpha, \
                  (const TDATA *)A,     \
                  (const TDATA *)B,     \
                  (const TDATA *)beta,  \
                  (TDATA *)C,           \
                  core_per_cluster,     \
                  cluster_count,        \
                  (cnrtQueue_t)stream)

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    const void *alpha,
    const void *A,
    const void *B,
    const void *beta,
    void *C,
    void *stream) const {

    (void)workspace;
    (void)workspace_size;

    int core_per_cluster = _opaque->internal->getCorePerCluster();
    int cluster_count = _opaque->internal->getClusterCount();

    switch (_info.data_type) {
    case INFINI_DTYPE_C64:
        return CALCULATE_HEMM(device::bang::FloatComplex);
    case INFINI_DTYPE_C128:
        return INFINI_STATUS_DEVICE_TYPE_NOT_SUPPORTED;
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

#undef CALCULATE_HEMM

} // namespace op::hemm::bang
