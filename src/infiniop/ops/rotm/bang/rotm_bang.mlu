#include "../../blas_cnnl_bang.h"
#include "rotm_bang.h"

namespace op::rotm::bang {

namespace {

bool isSupported(infiniDtype_t dtype) {
    return dtype == INFINI_DTYPE_F16
        || dtype == INFINI_DTYPE_BF16
        || dtype == INFINI_DTYPE_F32;
}

} // namespace

struct Descriptor::Opaque {
    blas_cnnl::bang::TensorDescriptor x;
    blas_cnnl::bang::TensorDescriptor y;
    blas_cnnl::bang::TensorDescriptor temp;
    blas_cnnl::bang::OpTensorDescriptor add;
    std::shared_ptr<device::bang::Handle::Internal> internal;
    size_t temp_workspace_size = 0;
    size_t add_workspace_size = 0;
    size_t copy_x_workspace_size = 0;
    size_t copy_y_workspace_size = 0;
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopTensorDescriptor_t x_desc,
    infiniopTensorDescriptor_t y_desc,
    infiniopTensorDescriptor_t param_desc) {

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto result = RotmInfo::createRotmInfo(x_desc, y_desc, param_desc);
    CHECK_RESULT(result);
    auto info = result.take();

    if (!isSupported(info.data_type)) {
        *desc_ptr = new Descriptor(
            info,
            0,
            nullptr,
            handle->device,
            handle->device_id);
        return INFINI_STATUS_SUCCESS;
    }

    auto opaque = new Opaque{};
    opaque->internal = handle->internal();
    opaque->temp_workspace_size = 2 * blas_cnnl::bang::vectorBytes(info.n, info.data_type);

    CHECK_STATUS(blas_cnnl::bang::setVectorTensor(opaque->x, info.n, info.incx, info.data_type));
    CHECK_STATUS(blas_cnnl::bang::setVectorTensor(opaque->y, info.n, info.incy, info.data_type));
    CHECK_STATUS(blas_cnnl::bang::setContiguousVectorTensor(opaque->temp, info.n, info.data_type));
    CHECK_STATUS(opaque->add.create(CNNL_OP_TENSOR_ADD));
    CHECK_STATUS(blas_cnnl::bang::getOpTensorWorkspaceSize(
        opaque->internal,
        opaque->x,
        opaque->y,
        opaque->temp,
        &opaque->add_workspace_size));
    CHECK_STATUS(blas_cnnl::bang::getCopyWorkspaceSize(
        opaque->internal,
        opaque->temp,
        opaque->x,
        &opaque->copy_x_workspace_size));
    CHECK_STATUS(blas_cnnl::bang::getCopyWorkspaceSize(
        opaque->internal,
        opaque->temp,
        opaque->y,
        &opaque->copy_y_workspace_size));

    const size_t op_workspace_size = std::max(
        opaque->add_workspace_size,
        std::max(opaque->copy_x_workspace_size, opaque->copy_y_workspace_size));

    *desc_ptr = new Descriptor(
        info,
        opaque->temp_workspace_size + op_workspace_size,
        opaque,
        handle->device,
        handle->device_id);

    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    void *x,
    void *y,
    const void *param,
    void *stream) const {

    if (!isSupported(_info.data_type)) {
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }

    CHECK_OR_RETURN(_opaque != nullptr, INFINI_STATUS_INTERNAL_ERROR);
    CHECK_OR_RETURN(workspace_size >= workspaceSize(), INFINI_STATUS_INSUFFICIENT_WORKSPACE);
    CHECK_OR_RETURN(workspace != nullptr || workspaceSize() == 0, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(x != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(y != nullptr, INFINI_STATUS_NULL_POINTER);
    CHECK_OR_RETURN(param != nullptr, INFINI_STATUS_NULL_POINTER);

    float h[5] = {};
    CHECK_STATUS(blas_cnnl::bang::copyVectorToFloat(h, param, 5, _info.data_type, (cnrtQueue_t)stream));

    if (_info.n == 0 || h[0] == -2.0f) {
        return INFINI_STATUS_SUCCESS;
    }

    float x_from_x = 0.0f;
    float x_from_y = 0.0f;
    float y_from_x = 0.0f;
    float y_from_y = 0.0f;

    if (h[0] < 0.0f) {
        x_from_x = h[1];
        x_from_y = h[3];
        y_from_x = h[2];
        y_from_y = h[4];
    } else if (h[0] == 0.0f) {
        x_from_x = 1.0f;
        x_from_y = h[3];
        y_from_x = h[2];
        y_from_y = 1.0f;
    } else {
        x_from_x = h[1];
        x_from_y = 1.0f;
        y_from_x = -1.0f;
        y_from_y = h[4];
    }

    const size_t vector_bytes = blas_cnnl::bang::vectorBytes(_info.n, _info.data_type);
    void *new_x = workspace;
    void *new_y = blas_cnnl::bang::workspaceAt(workspace, vector_bytes);
    void *op_workspace = blas_cnnl::bang::workspaceAt(workspace, _opaque->temp_workspace_size);
    const size_t op_workspace_size = workspace_size - _opaque->temp_workspace_size;
    void *x_ptr = blas_cnnl::bang::logicalVectorPtr(x, _info.n, _info.incx, _info.data_type);
    void *y_ptr = blas_cnnl::bang::logicalVectorPtr(y, _info.n, _info.incy, _info.data_type);

    CHECK_STATUS(blas_cnnl::bang::cnnlOpTensor(
        _opaque->internal,
        (cnrtQueue_t)stream,
        _opaque->add,
        x_from_x,
        _opaque->x,
        x_ptr,
        x_from_y,
        _opaque->y,
        y_ptr,
        op_workspace,
        op_workspace_size,
        0.0f,
        _opaque->temp,
        new_x));
    CHECK_STATUS(blas_cnnl::bang::cnnlOpTensor(
        _opaque->internal,
        (cnrtQueue_t)stream,
        _opaque->add,
        y_from_x,
        _opaque->x,
        x_ptr,
        y_from_y,
        _opaque->y,
        y_ptr,
        op_workspace,
        op_workspace_size,
        0.0f,
        _opaque->temp,
        new_y));
    CHECK_STATUS(blas_cnnl::bang::cnnlCopy(
        _opaque->internal,
        (cnrtQueue_t)stream,
        _opaque->temp,
        new_x,
        _opaque->x,
        x_ptr,
        op_workspace,
        op_workspace_size));
    CHECK_STATUS(blas_cnnl::bang::cnnlCopy(
        _opaque->internal,
        (cnrtQueue_t)stream,
        _opaque->temp,
        new_y,
        _opaque->y,
        y_ptr,
        op_workspace,
        op_workspace_size));
    CHECK_STATUS(blas_cnnl::bang::syncQueue((cnrtQueue_t)stream));

    return INFINI_STATUS_SUCCESS;
}

} // namespace op::rotm::bang
